{
  "name": "Studia Theme",

  // Pinned to the same major as .nvmrc, which CI reads: `npm ci` fails the
  // engines check on an older Node, and Codespaces' default image does not
  // guarantee it. An even major, because that is what a Node LTS line is.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",

  "postCreateCommand": "npm ci",

  // The forwarded root redirects to the based URL. docs/Deploying.md.
  "forwardPorts": [4321],
  "portsAttributes": {
    "4321": { "label": "astro dev", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["astro-build.astro-vscode", "esbenp.prettier-vscode"]
    }
  }
}
