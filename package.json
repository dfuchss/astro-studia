{
  "name": "astro-studia",
  "version": "0.1.0",
  "description": "An academic Astro starter: publications from BibTeX, paper pages, projects, blog, CV, people. No UI framework, no CSS framework, dark only.",
  "license": "MIT",
  "author": "Dominik Fuchß",
  "repository": {
    "type": "git",
    "url": "https://github.com/dfuchss/astro-studia"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "astro dev",
    "dev:fresh": "astro dev stop 2>/dev/null; rm -rf .astro node_modules/.vite && astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && prettier . --check",
    "format": "prettier . --write",
    "audit": "node scripts/audit-site.mjs",
    "favicons": "node scripts/generate-favicons.mjs",
    "data:github": "node scripts/fetch-github-metadata.mjs",
    "bib:check": "python3 scripts/update_bib.py",
    "docs": "node scripts/gen-docs.mjs",
    "docs:check": "node scripts/gen-docs.mjs --check"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.0",
    "@fontsource/jetbrains-mono": "^5.2.9",
    "@fontsource/space-grotesk": "^5.3.0",
    "@retorquere/bibtex-parser": "^11.0.0",
    "astro": "^7.3.5",
    "sharp": "^0.35.5",
    "yaml": "^2.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.4",
    "prettier": "^3.8.0",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
