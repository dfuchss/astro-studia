---
import { SITE } from '../consts.ts';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// The page title, or the site's own on the home page — never "Home · Site".
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const desc = description ?? SITE.description;

// Safe because astro.config.ts sets trailingSlash: 'always' with
// build.format: 'directory', which makes Astro.url.pathname the address a
// visitor actually sees. Under build.format: 'preserve' it would be the file
// path ("/papers/sosp67.html") and every canonical here would be wrong.
const canonical = new URL(Astro.url.pathname, SITE.url);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canonical} />

{
  /* Three icons, in the order a browser should prefer them. The SVG scales to
    any size and follows the palette; the 32px PNG is the fallback for the few
    browsers that still ignore SVG icons; apple-touch-icon is what iOS uses
    when someone adds the site to their home screen and is the one that looks
    wrong by its absence. Regenerate the PNGs with `npm run favicons` after
    editing public/favicon.svg. */
}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="manifest" href="/site.webmanifest" />

{/* Delete this line along with src/pages/feed.xml.ts if you drop the blog. */}
<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/feed.xml" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canonical} />

{
  /* The card type follows whether there is actually an image to put in it.
     summary_large_image with no image renders as a blank rectangle, which is
     worse than the small card it replaced — so SITE.ogImage: null gets the
     small one, honestly. */
}
{
  SITE.ogImage ? (
    <>
      <meta property="og:image" content={new URL(SITE.ogImage, SITE.url)} />
      <meta name="twitter:image" content={new URL(SITE.ogImage, SITE.url)} />
      <meta name="twitter:card" content="summary_large_image" />
    </>
  ) : (
    <meta name="twitter:card" content="summary" />
  )
}

<meta name="generator" content={Astro.generator} />
