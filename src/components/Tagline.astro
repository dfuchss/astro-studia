---
import type { Tagline } from '../consts.ts';

/*
 * SITE.tagline, rendered. The parts join with NO added whitespace, because
 * ", Germany" straight after a link is the case this exists for.
 */
interface Props {
  text: Tagline;
}
const { text } = Astro.props;
---

{
  typeof text === 'string' ? (
    text
  ) : (
    <>
      {text.before}
      <a href={text.link.href} rel={text.link.href.startsWith('http') ? 'noopener' : undefined}>
        {text.link.label}
      </a>
      {text.after}
    </>
  )
}
