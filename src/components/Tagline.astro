---
import type { Tagline } from '../consts.ts';

/*
 * SITE.tagline, rendered. The three parts are joined with NO added
 * whitespace — `before` ends with the space before the link, `after` starts
 * with the comma after it — because ", Germany" is the case this exists for.
 */
interface Props {
  text: Tagline;
}
const { text } = Astro.props;
---

{
  typeof text === 'string' ? (
    text
  ) : (
    <>
      {text.before}
      <a href={text.link.href} rel={text.link.href.startsWith('http') ? 'noopener' : undefined}>
        {text.link.label}
      </a>
      {text.after}
    </>
  )
}
