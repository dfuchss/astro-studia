---
import { NAV, SITE, type Section } from '../consts.ts';

interface Props {
  section?: Section;
}

const { section } = Astro.props;
---

<header class="nav">
  <div class="wrap inner">
    <a class="brand mono" href="/">
      {SITE.brandPrompt && <span class="brand-prompt">{SITE.brandPrompt}</span>}{SITE.brand}
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                data-section={item.section}
                aria-current={item.section === section ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
  }

  /* A wordmark, not an image. If you want a logo here instead, put one in
     public/ and render it beside the text — see docs/theming.md. */
  .brand {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .brand-prompt {
    color: var(--text-faint);
  }
  .brand:hover {
    color: var(--sec-strong);
  }

  /* No hamburger: short items wrap onto a second line on narrow screens, which
     is less machinery and one fewer thing that can trap focus. */
  /* Pushed to the right edge, and kept there once it wraps. space-between on
     .inner already does this while the two sit on one line; margin-left:auto
     plus flex-end is what holds the alignment when the items drop onto a line
     of their own, which they do as soon as the nav is long or the window is
     narrow. */
  nav {
    margin-left: auto;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.25rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul a {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
  }

  /* Each item previews the accent of the section it leads to, so arriving is a
     continuation rather than a surprise.
     
     One rule covers every section, and adding one costs nothing here: the
     link's own `data-section` attribute is matched by the [data-section='…']
     blocks in tokens.css, which have already re-pointed --sec *inside this
     element* before this rule reads it. */
  ul a:hover,
  ul a[aria-current='page'] {
    color: var(--sec);
    border-bottom-color: var(--sec-line);
  }
</style>
