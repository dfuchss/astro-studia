---
import { NAV, SITE, type Section } from '../consts.ts';

interface Props {
  section?: Section;
}

const { section } = Astro.props;
---

<header class="nav">
  <div class="wrap inner">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" width="26" height="26" />
      <span>{SITE.brand}</span>
    </a>

    <nav aria-label="Primary">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                data-section={item.section}
                aria-current={item.section === section ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    min-height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .brand img {
    border-radius: var(--radius-s);
  }
  .brand:hover {
    color: var(--sec-strong);
  }

  /* No hamburger: short items wrap onto a second line on narrow screens, which
     is less machinery and one fewer thing that can trap focus. */
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
  }

  ul a {
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
  }

  /* Each item previews the accent of the section it leads to, so arriving is a
     continuation rather than a surprise.
     
     One rule covers every section, and adding one costs nothing here: the
     link's own `data-section` attribute is matched by the [data-section='…']
     blocks in tokens.css, which have already re-pointed --sec *inside this
     element* before this rule reads it. */
  ul a:hover,
  ul a[aria-current='page'] {
    color: var(--sec);
    border-bottom-color: var(--sec-line);
  }
</style>
