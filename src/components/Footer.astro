---
import { SITE, FOOTER, shown } from '../consts.ts';
import { fill, getPage, need, selfName } from '../lib/pages.ts';
import DemoNotice from './DemoNotice.astro';
import Email from './Email.astro';

/*
 * The words are src/content/pages/site/footer.md; which optional parts render
 * is FOOTER in src/consts.ts. The credit is the theme's branding and stays
 * here. Anything else goes through the default slot, which Base.astro forwards
 * as its `footer` slot.
 */
const footer = await getPage('site/footer');
const affiliation = footer.data.affiliation ?? [];
const links = shown(footer.data.links ?? []);
const holder = fill(need(footer.data.copyright, 'site/footer.copyright'), { name: selfName });
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    {/* One wrapping row of middot-separated parts, and every {' '} in it is
         load-bearing: Astro strips the newline before an <a>, and the audit
         fails the build on "Astro andStudia Theme".

         The copyright is the only part that is always there, so each optional
         part can carry its own leading separator and no combination of them
         can leave a dot dangling at either end. */}
    <p class="meta mono">
      <span>{`© ${year} ${holder}`}</span>

      {
        /* No whitespace between the parts, so " and " and ", " are exactly what
           footer.md wrote. */
        affiliation.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <span>
              {affiliation.map((part) =>
                typeof part === 'string' ? (
                  part
                ) : (
                  <a href={part.href} rel={part.href.startsWith('http') ? 'noopener' : undefined}>
                    {part.label}
                  </a>
                ),
              )}
            </span>
          </>
        )
      }

      {links.map((link) => (
        <>
          <span aria-hidden="true">·</span>
          <a href={link.href}>{link.label}</a>
        </>
      ))}

      {FOOTER.email && (
        <>
          <span aria-hidden="true">·</span>
          {/* Through Email.astro, never a mailto: the audit fails the build on
              any address-shaped string in the served bytes. */}
          <Email address={SITE.email} label={need(footer.data.email, 'site/footer.email')} />
        </>
      )}

      {FOOTER.credit && (
        <>
          <span aria-hidden="true">·</span>
          <span>
            built with <a href="https://astro.build/">Astro</a> and{' '}
            <a href={SITE.repo}>Studia Theme</a>
          </span>
        </>
      )}

      <DemoNotice variant="line" />
      <slot />
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-block: 2rem 3rem;
    color: var(--text-faint);
  }

  /* Wraps rather than stacking: the parts are one sentence of metadata, not
     four blocks that each deserved a line of their own. */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5ch;
    margin: 0;
  }

  a,
  :global(.foot .email) {
    color: var(--text-muted);
    text-decoration-color: var(--border-strong);
  }
  a:hover {
    color: var(--sec-strong);
  }
</style>
