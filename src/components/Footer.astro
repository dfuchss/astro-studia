---
import { SITE, FOOTER, FOOTER_LINKS } from '../consts.ts';
import DemoNotice from './DemoNotice.astro';
import Email from './Email.astro';

/*
 * Everything that differs between sites is FOOTER and FOOTER_LINKS in
 * src/consts.ts; the rest goes through the default slot, which Base.astro
 * forwards as its `footer` slot.
 */
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap inner">
    <p class="mono">
      {
        /* One string: two expressions on separate lines render "2026Cicero", because
          Astro strips the newline between them. */
      }
      {`© ${year} ${SITE.copyright}`}
      {
        /* No whitespace between the parts, so " and " and ", " are exactly what the
           config wrote; the leading `{' '}` is the space after the name. */
        FOOTER.affiliation.length > 0 && (
          <span class="affiliation">
            {' '}
            <span aria-hidden="true">·</span>{' '}
            {FOOTER.affiliation.map((part) =>
              typeof part === 'string' ? (
                part
              ) : (
                <a href={part.href} rel={part.href.startsWith('http') ? 'noopener' : undefined}>
                  {part.label}
                </a>
              ),
            )}
          </span>
        )
      }
    </p>

    <DemoNotice variant="line" />

    {
      (FOOTER_LINKS.length > 0 || FOOTER.email) && (
        <nav aria-label="Secondary">
          <ul>
            {FOOTER_LINKS.map((link) => (
              <li>
                <a class="mono" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
            {FOOTER.email && (
              <li>
                {/* Through Email.astro, never a mailto: the audit fails the build
                    on any address-shaped string in the served bytes. */}
                <Email address={SITE.email} label="Email" class="mono" />
              </li>
            )}
          </ul>
        </nav>
      )
    }

    <slot />

    {
      /* The {' '} is load-bearing: Astro strips the newline before the <a>, so
        this renders "Astro andStudia Theme" and the audit fails the build. */
      FOOTER.credit && (
        <p class="mono built">
          Built with <a href="https://astro.build/">Astro</a> and{' '}
          <a href={SITE.repo}>Studia Theme</a>
        </p>
      )
    }
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--border);
    margin-top: clamp(3rem, 8vw, 6rem);
    padding-block: 2rem 3rem;
    color: var(--text-faint);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
  }

  p {
    margin: 0;
  }

  /* Pushed to the far end on a wide viewport; wraps underneath on a phone. */
  .built {
    margin-left: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a,
  :global(.foot .email) {
    color: var(--text-muted);
    text-decoration-color: var(--border-strong);
  }
  a:hover {
    color: var(--sec-strong);
  }
</style>
