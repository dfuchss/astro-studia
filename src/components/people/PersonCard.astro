---
import { Image } from 'astro:assets';

import Email from '../Email.astro';
import type { Member } from '../../lib/people.ts';
import { PEOPLE_CHIPS } from '../../consts.ts';

interface Props {
  member: Member;
}

const { member } = Astro.props;
const { entry, author } = member;
const d = entry.data;

/* Width only: a non-square portrait keeps its ratio and is cropped by
   `object-fit: cover`, rather than squashed into a square by sharp. */
const PORTRAIT = 72;

// Each is optional in people.yml, so a person with none renders as a name and
// a portrait. The words on the chips are PEOPLE_CHIPS in src/consts.ts.
const profiles = [
  d.url && { label: PEOPLE_CHIPS.homepage, href: d.url },
  author.data.orcid && {
    label: PEOPLE_CHIPS.orcid === 'id' ? author.data.orcid : 'ORCID',
    href: `https://orcid.org/${author.data.orcid}`,
    title: `ORCID ${author.data.orcid}`,
  },
  d.github && { label: PEOPLE_CHIPS.github, href: `https://github.com/${d.github}` },
].filter(Boolean) as { label: string; href: string; title?: string }[];
---

<li class="person reveal" id={entry.id}>
  <Image
    class="portrait"
    src={d.image}
    alt=""
    width={PORTRAIT}
    densities={[1, 2]}
    loading="lazy"
    decoding="async"
  />

  <div class="body">
    <h2>{author.data.name}</h2>
    {d.role && <p class="role mono">{d.role}</p>}

    <div class="chips">
      {
        profiles.map((p) => (
          <a class="chip" href={p.href} rel="noopener" title={p.title}>
            {p.label}
          </a>
        ))
      }
      {d.email && <Email address={d.email} label={PEOPLE_CHIPS.email} class="chip" />}
    </div>
  </div>
</li>

<style>
  /* Flat, like the rest of the site: a hairline rule, not a filled tile. */
  .person {
    list-style: none;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1rem 0.5rem 0;
    border-top: 1px solid var(--border);
    border-radius: var(--radius-s);
    transition: border-color var(--dur) var(--ease);
  }
  .person:hover {
    border-top-color: var(--sec-line);
  }
  /* Arriving from an author link should say which person you were sent to. */
  .person:target {
    border-top-color: var(--sec-line);
    background: var(--sec-dim);
  }

  .portrait {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--sec-line);
    box-shadow: 0 0 0 4px var(--sec-dim);
  }

  .body {
    min-width: 0;
    padding-bottom: 1rem;
  }
  h2 {
    font-size: 1.0625rem;
    margin: 0 0 0.15rem;
  }
  .role {
    margin: 0 0 0.6rem;
    color: var(--sec);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
