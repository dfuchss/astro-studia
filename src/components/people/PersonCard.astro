---
import { intrinsic } from '../../lib/images.ts';
import Email from '../Email.astro';
import type { Member } from '../../lib/people.ts';

interface Props {
  member: Member;
}

const { member } = Astro.props;
const { entry, author } = member;
const d = entry.data;

const { width, height } = intrinsic(d.image);

// Each of these is optional in people.yml, so a person with none of them
// renders as a name and a portrait and nothing looks broken.
const profiles = [
  d.url && { label: 'Homepage', href: d.url },
  author.data.orcid && {
    label: 'ORCID',
    href: `https://orcid.org/${author.data.orcid}`,
  },
  d.github && { label: 'GitHub', href: `https://github.com/${d.github}` },
].filter(Boolean) as { label: string; href: string }[];
---

<li class="person reveal" id={entry.id}>
  <img
    class="portrait"
    src={d.image}
    alt=""
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />

  <div class="body">
    <h2>{author.data.name}</h2>
    {d.role && <p class="role mono">{d.role}</p>}

    <div class="chips">
      {
        profiles.map((p) => (
          <a class="chip" href={p.href} rel="noopener">
            {p.label}
          </a>
        ))
      }
      {d.email && <Email address={d.email} label="Email" class="chip" />}
    </div>
  </div>
</li>

<style>
  /* Flat, like the rest of the site: a hairline rule rather than a filled
     tile. The portrait is the only solid shape in the row. */
  .person {
    list-style: none;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1rem 0.5rem 0;
    border-top: 1px solid var(--border);
    border-radius: var(--radius-s);
    transition: border-color var(--dur) var(--ease);
  }
  .person:hover {
    border-top-color: var(--sec-line);
  }
  /* Arriving from an author link in the publication list should say which of
     these you were sent to. */
  .person:target {
    border-top-color: var(--sec-line);
    background: var(--sec-dim);
  }

  .portrait {
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--sec-line);
    box-shadow: 0 0 0 4px var(--sec-dim);
  }

  .body {
    min-width: 0;
    padding-bottom: 1rem;
  }
  h2 {
    font-size: 1.0625rem;
    margin: 0 0 0.15rem;
  }
  .role {
    margin: 0 0 0.6rem;
    color: var(--sec);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
</style>
