---
import { socials } from '../lib/data.ts';

/**
 * Profile links.
 *
 * Icon-only: the platform name lives in `aria-label` and `title`, the same way
 * CopyButton.astro carries its label. The marks are Simple Icons paths
 * (CC0, https://simpleicons.org) inlined rather than pulled from a package —
 * one path each, and no icon dependency for a handful of glyphs. Every one is a
 * single 24x24 path drawn in `currentColor`, so the row picks up the chip
 * colour and the section accent on hover for free.
 *
 * Adding a profile that is not in this list does NOT mean editing this file:
 * put it under `extra:` in src/data/socials.yml. With an `icon` naming one of
 * the marks below it renders as an icon; without one it renders as a text
 * chip, which is why an unknown platform still looks deliberate rather than
 * broken. That escape hatch matters — the set of places an academic keeps a
 * profile is not something a template can enumerate.
 */
const ICONS = {
  orcid:
    'M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.025-5.325 5.025h-3.919V7.416zm1.444 1.303v7.444h2.297c3.272 0 4.022-2.484 4.022-3.722 0-2.016-1.284-3.722-4.097-3.722h-2.222z',
  scholar:
    'M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z',
  dblp: 'M3.075.002c-.096.013-.154.092-.094.31L4.97 7.73 3.1 8.6s-.56.26-.4.85l2.45 9.159s.16.59.72.33l6.169-2.869 1.3-.61s.52-.24.42-.79l-.01-.06-1.13-4.22-.658-2.45-.672-2.49v-.04s-.16-.59-.84-1L3.5.141s-.265-.16-.425-.139zM18.324 5.03a.724.724 0 0 0-.193.06l-5.602 2.6.862 3.2 1.09 4.08.01.06c.05.47-.411.79-.411.79l-1.88.87.5 1.89.04.1c.07.17.28.6.81.91l6.95 4.269s.68.41.52-.17l-1.981-7.4 1.861-.86s.56-.26.4-.85L18.85 5.42s-.116-.452-.526-.39z',
  github:
    'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
  codeberg:
    'M11.999.747A11.974 11.974 0 0 0 0 12.75c0 2.254.635 4.465 1.833 6.376L11.837 6.19c.072-.092.251-.092.323 0l4.178 5.402h-2.992l.065.239h3.113l.882 1.138h-3.674l.103.374h3.86l.777 1.003h-4.358l.135.483h4.593l.695.894h-5.038l.165.589h5.326l.609.785h-5.717l.182.65h6.038l.562.727h-6.397l.183.65h6.717A12.003 12.003 0 0 0 24 12.75 11.977 11.977 0 0 0 11.999.747zm3.654 19.104.182.65h5.326c.173-.204.353-.433.513-.65zm.385 1.377.18.65h3.563c.233-.198.485-.428.712-.65zm.383 1.377.182.648h1.203c.356-.204.685-.412 1.042-.648z',
  linkedin:
    'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
  semanticscholar:
    'M24 8.609c-.848.536-1.436.83-2.146 1.245-4.152 2.509-8.15 5.295-11.247 8.981l-1.488 1.817-4.568-7.268c1.021.814 3.564 3.098 4.603 3.599l3.356-2.526c2.336-1.644 8.946-5.226 11.49-5.848ZM8.046 15.201c.346.277.692.537.969.744.761-3.668.121-7.613-1.886-11.039 3.374-.052 6.731-.087 10.105-.139a14.794 14.794 0 0 1 1.298 5.295c.294-.156.588-.294.883-.433-.104-1.868-.641-3.91-1.662-6.263-4.602-.018-9.188-.018-13.79-.018 2.993 3.547 4.36 7.839 4.083 11.853Zm-.623-.484c.087.086.191.155.277.225-.138-3.409-1.419-6.887-3.824-9.881H1.73c3.098 2.855 4.984 6.299 5.693 9.656Zm-.744-.658c.104.087.208.173.329.277-.9-2.526-2.492-5.018-4.741-7.198H0c2.89 2.076 5.122 4.481 6.679 6.921Z',
} as const;

type Icon = keyof typeof ICONS;

/** A chip: an icon when we have a mark for it, otherwise the label as text. */
type Link = { label: string; href: string; icon?: Icon };

const known = (name: string | null | undefined): Icon | undefined =>
  name && name in ICONS ? (name as Icon) : undefined;

/*
 * Every entry is dropped when its id is unset, so removing a profile you do not
 * have is a null in the data file rather than an edit here. rel="me" is what
 * lets those profiles verify this site back — Mastodon and IndieAuth both read
 * it.
 */
const links: Link[] = [
  socials.orcid_id && {
    label: 'ORCID',
    href: `https://orcid.org/${socials.orcid_id}`,
    icon: 'orcid' as const,
  },
  socials.scholar_userid && {
    label: 'Google Scholar',
    href: `https://scholar.google.com/citations?user=${socials.scholar_userid}`,
    icon: 'scholar' as const,
  },
  socials.dblp_url && { label: 'DBLP', href: socials.dblp_url, icon: 'dblp' as const },
  socials.github_username && {
    label: 'GitHub',
    href: `https://github.com/${socials.github_username}`,
    icon: 'github' as const,
  },
  socials.semanticscholar_id && {
    label: 'Semantic Scholar',
    href: `https://www.semanticscholar.org/author/${socials.semanticscholar_id}`,
    icon: 'semanticscholar' as const,
  },
  socials.linkedin_username && {
    label: 'LinkedIn',
    href: `https://www.linkedin.com/in/${socials.linkedin_username}`,
    icon: 'linkedin' as const,
  },
  ...(socials.extra ?? []).map((e) => ({ label: e.label, href: e.url, icon: known(e.icon) })),
].filter(Boolean) as Link[];
---

{
  links.length > 0 && (
    <ul class="row">
      {links.map((l) => (
        <li>
          <a
            class:list={['chip', l.icon && 'social']}
            href={l.href}
            rel="me noopener"
            aria-label={l.icon ? l.label : undefined}
            title={l.label}
          >
            {l.icon ? (
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
                <path d={ICONS[l.icon]} />
              </svg>
            ) : (
              l.label
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  /* Square-in-a-circle: `.chip` already supplies the pill border and the hover
     accent, so this only drops the text padding and fixes the tap target.
     2.25rem keeps it above the 24px minimum a touch target wants. */
  .social {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    display: grid;
    place-items: center;
  }
  .social svg {
    fill: currentColor;
  }
</style>
