} as const;

type Icon = keyof typeof ICONS;

/** A chip: an icon when we have a mark for it, otherwise the label as text. */
type Link = { label: string; href: string; icon?: Icon };

const known = (name: string | null | undefined): Icon | undefined =>
  name && name in ICONS ? (name as Icon) : undefined;

/*
 * One shape for every profile: the platform, the value from socials.yml, and
 * how that value becomes a URL. A platform whose value is unset is dropped by
 * the one filter below, so an optional platform is not a special case.
 */
const profiles: {
  label: string;
  value: string | null;
  url: (value: string) => string;
  icon?: Icon;
}[] = [
  {
    label: 'ORCID',
    value: socials.orcid_id,
    url: (id) => `https://orcid.org/${id}`,
    icon: 'orcid',
  },
  {
    label: 'Google Scholar',
    value: socials.scholar_userid,
    url: (id) => `https://scholar.google.com/citations?user=${id}`,
    icon: 'scholar',
  },
  { label: 'DBLP', value: socials.dblp_url, url: (address) => address, icon: 'dblp' },
  {
    label: 'GitHub',
    value: socials.github_username,
    url: (username) => `https://github.com/${username}`,
    icon: 'github',
  },
  {
    label: 'Semantic Scholar',
    value: socials.semanticscholar_id,
    url: (id) => `https://www.semanticscholar.org/author/${id}`,
    icon: 'semanticscholar',
  },
  {
    label: 'LinkedIn',
    value: socials.linkedin_username,
    url: (username) => `https://www.linkedin.com/in/${username}`,
    icon: 'linkedin',
  },
  {
    label: 'ResearchGate',
    value: socials.researchgate_username,
    url: (username) => `https://www.researchgate.net/profile/${username}`,
    icon: 'researchgate',
  },
  // Anything the fixed fields do not cover: the same shape, its URL as written.
  ...(socials.extra ?? []).map((extra) => ({
    label: extra.label,
    value: extra.url,
    url: (address: string) => address,
    icon: known(extra.icon),
  })),
];

// rel="me" lets those profiles verify this site back (Mastodon, IndieAuth).
const links: Link[] = profiles.flatMap((profile) =>
  profile.value
    ? [{ label: profile.label, href: profile.url(profile.value), icon: profile.icon }]
    : [],
);
---

{
  links.length > 0 && (
    <ul class="row">
      {links.map((link) => (
        <li>
          <a
            class:list={['chip', link.icon && 'social']}
            href={link.href}
            rel="me noopener"
            aria-label={link.icon ? link.label : undefined}
            title={link.label}
          >
            {link.icon ? (
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
                <path d={ICONS[link.icon]} />
              </svg>
            ) : (
              link.label
            )}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  /* `.chip` already supplies the border and the hover accent; this only drops
     the text padding and holds the tap target above the 24px minimum. */
  .social {
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    display: grid;
    place-items: center;
  }
  .social svg {
    fill: currentColor;
  }
</style>
