---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { projectPath } from '../../lib/paths.ts';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const d = project.data;

// An entry with `redirect` has no page of its own; the card links straight out.
const href = d.redirect ?? projectPath(project.id);
const external = Boolean(d.redirect);

// Fallback when there is no logo: the first two initials of the title. Keeps
// the grid even, and means a new project needs no artwork to look finished.
const initials = d.title
  .split(/\s+/)
  .filter((w) => /[a-zA-Z]/.test(w[0] ?? ''))
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');
---

<li class="project reveal">
  <a class="hit" href={href} rel={external ? 'noopener' : undefined}>
    <div class="head">
      {
        d.logo ? (
          /* densities 1x and 2x: the logo is small and rendered at a fixed
             size, so the retina variant is cheap and the difference obvious. */
          <Image class="logo" src={d.logo} alt="" width={44} height={44} densities={[1, 2]} />
        ) : (
          <span class="logo fallback mono" aria-hidden="true">
            {initials}
          </span>
        )
      }
      <h3>{d.title}</h3>
      {
        /* A sibling of the heading, not a child of it: `.head` is the flex
           container, so margin-left:auto here floats the arrow to the right
           edge of the card. Inside the <h3> it is an inline span and the auto
           margin computes to zero, which silently parks it against the title. */
        external && (
          <span class="out" aria-label="(external link)">
            ↗
          </span>
        )
      }
    </div>
    <p>{d.description}</p>
  </a>
</li>

<style>
  .project {
    list-style: none;
  }

  /* Flat, like the rest of the site: a hairline rule instead of a filled tile.
     The whole card is the link, so there is no small target inside a large
     clickable-looking box. */
  .hit {
    display: grid;
    gap: 0.6rem;
    height: 100%;
    align-content: start;
    padding: 1rem 0 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur) var(--ease);
  }
  .hit:hover {
    border-top-color: var(--sec-line);
  }
  .hit:hover h3 {
    color: var(--sec-strong);
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .logo {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    object-fit: contain;
    border-radius: var(--radius-s);
  }
  .fallback {
    display: grid;
    place-items: center;
    background: var(--sec-dim);
    border: 1px solid var(--sec-line);
    color: var(--sec);
    text-transform: uppercase;
    font-weight: 600;
    font-size: 0.9rem;
  }

  h3 {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .out {
    margin-left: auto;
    color: var(--text-faint);
    font-size: 0.85em;
  }

  p {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
</style>
