---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import { SITE, SELF, STAT_LABELS } from '../../consts.ts';
import { portrait, PORTRAIT_SIZE } from '../../lib/portrait.ts';
import Tagline from '../Tagline.astro';
/* Unfenced: every stat row below is optional, the formatting is not. */
import { formatCount } from '../../lib/format.ts';
/* ▼ FEATURE:socials ▼ */
import SocialRow from '../SocialRow.astro';
/* ▲ FEATURE:socials ▲ */

/*
 * The hero for a person's site: a name, a role, a pitch, and the counts that
 * back them up.
 */
/* ▼ FEATURE:demo ▼ */
/* See ProjectHero.astro for the other shape. src/pages/index.astro carries
   both inside ▼ PRESET:… ▼ fences, and init keeps one — this note is fenced
   so it goes with the choice. */
/* ▲ FEATURE:demo ▲ */
/* ▼ FEATURE:publications ▼ */
import { PUBLICATIONS } from '../../lib/paths.ts';
const pubs = await getCollection('publications');
/* ▲ FEATURE:publications ▲ */
/* ▼ FEATURE:projects ▼ */
import { PROJECTS } from '../../lib/paths.ts';
const projects = await getCollection('projects');
/* ▲ FEATURE:projects ▲ */
/* ▼ FEATURE:citations ▼ */
import { scholarMetrics } from '../../lib/citations.ts';
const m = scholarMetrics();
/* ▲ FEATURE:citations ▲ */

/*
 * Counted, never typed in: a hardcoded "35 publications" is wrong the day you
 * add the thirty-sixth. A stat of 0 is dropped. One row per line, each fenced
 * by the feature it counts, so pruning that feature takes its row and its
 * `getCollection` above with it. Annotated because a selection can fence every
 * row away, and an empty literal infers as `never[]`.
 */
type Stat = { value: number; label: string; href: string };

const rows: Stat[] = [
  /* ▼ FEATURE:publications ▼ */
  { value: pubs.length, label: STAT_LABELS.publications, href: PUBLICATIONS },
  /* ▲ FEATURE:publications ▲ */
  /* ▼ FEATURE:citations ▼ */
  { value: m.total, label: STAT_LABELS.citations, href: PUBLICATIONS },
  { value: m.hIndex, label: STAT_LABELS.hIndex, href: PUBLICATIONS },
  /* ▲ FEATURE:citations ▲ */
  /* ▼ FEATURE:projects ▼ */
  { value: projects.length, label: STAT_LABELS.projects, href: PROJECTS },
  /* ▲ FEATURE:projects ▲ */
];
const stats = rows.filter((s) => s.value > 0);
---

<section class="wrap hero">
  <div class="hero-grid">
    <div>
      <p class="kicker">whoami</p>
      <h1>{SELF.first}&nbsp;{SELF.last}</h1>
      {/* The role line can carry one link — see SITE.tagline and Tagline.astro. */}
      <p class="role"><Tagline text={SITE.tagline} /></p>
      <p class="pitch">
        I write about <strong>duty</strong>, <strong>friendship</strong> and what holds a republic together,
        and I argue that Latin is perfectly capable of the job — which is a claim you can only make by
        doing it.
      </p>
      {/* ▼ FEATURE:socials ▼ */}
      <SocialRow />
      {/* ▲ FEATURE:socials ▲ */}
    </div>

    <figure class="portrait">
      <Image src={portrait} alt="" width={PORTRAIT_SIZE} height={PORTRAIT_SIZE} loading="eager" />
    </figure>
  </div>

  {
    stats.length > 0 && (
      <ul class="stats">
        {stats.map((s) => (
          <li>
            <a href={s.href}>
              <span class="stat-value">{formatCount(s.value)}</span>
              <span class="stat-label mono">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) 0;
  }
  .hero-grid {
    display: grid;
    /* Cap the text column at its reading measure. With `1fr` the column eats
       all the free width and pushes the portrait to the far edge, leaving a
       void between the two. `start` keeps the pair together, left-aligned like
       every other section on the page. */
    grid-template-columns: minmax(0, 64ch) auto;
    justify-content: start;
    gap: 2.5rem;
    align-items: center;
  }

  h1 {
    margin-bottom: 0.35rem;
  }
  .role {
    font-size: 1.0625rem;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }
  .pitch {
    max-width: 56ch;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .pitch strong {
    color: var(--text);
    font-weight: 600;
  }

  .portrait {
    margin: 0;
    text-align: center;
  }
  .portrait :global(img) {
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--sec-line);
    box-shadow: 0 0 0 6px var(--sec-dim);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  /* No box: a hairline rule over each figure, matching the dividers the rest
     of the site uses. The number carries the emphasis, not a border. */
  .stats a {
    display: grid;
    gap: 0.1rem;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .stats a:hover {
    border-top-color: var(--sec-line);
  }
  .stats a:hover .stat-label {
    color: var(--sec);
  }
  .stat-value {
    font-family: var(--font-head);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--sec);
  }
  .stat-label {
    color: var(--text-faint);
    font-size: 0.6875rem;
  }

  @media (max-width: 44rem) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    /* Portrait above the text on a phone: an 11rem image beside a paragraph at
       that width leaves the paragraph a few characters wide. It also shrinks —
       full desktop size on a phone eats the fold. cv.astro does the same. */
    .portrait {
      order: -1;
      text-align: left;
    }
    .portrait :global(img) {
      width: 7rem;
      height: 7rem;
    }
  }
</style>
