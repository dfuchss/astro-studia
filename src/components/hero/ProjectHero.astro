---
import { getCollection } from 'astro:content';

import { SITE } from '../../consts.ts';
import { intrinsic } from '../../lib/images.ts';
/* ▼ FEATURE:citations ▼ */
import { formatCount } from '../../lib/citations.ts';
/* ▲ FEATURE:citations ▲ */

/*
 * The hero for a project or group site: a mark, a name, a tagline, and the
 * actions a visitor is most likely to want.
 */
/* ▼ FEATURE:demo ▼ */
/*
 * See PersonHero.astro for the shape a person's site wants instead. Neither
 * takes props: src/pages/index.astro carries both, each inside its own
 * ▼ PRESET:… ▼ fences, and `npm run init` keeps one and deletes the other —
 * this note with it, which is why it is fenced rather than left to describe a
 * component that is no longer there.
 */
/* ▲ FEATURE:demo ▲ */

/*
 * The same mark as the nav, from SITE.brandLogo, so a site that has a logo
 * does not show it in the corner and a favicon in the middle of its own front
 * page. This used to be '/favicon.svg' outright, which meant ardoco.de had to
 * edit a component to put its own logo on its own home page.
 *
 * The favicon is the FALLBACK, not the default: with no brand mark configured
 * a centred hero still needs something above the title, and the favicon is the
 * one image every site in this template is guaranteed to have.
 */
const logo = SITE.brandLogo?.src ?? '/favicon.svg';
const { width: logoWidth, height: logoHeight } = intrinsic(logo);

/* One row per line and each fenced, for the reason the stats below are. */
const actions = [
  /* ▼ FEATURE:projects ▼ */
  { label: 'Explore projects', href: PROJECTS, primary: true },
  /* ▲ FEATURE:projects ▲ */
  /* ▼ FEATURE:publications ▼ */
  { label: 'Publications', href: PUBLICATIONS },
  /* ▲ FEATURE:publications ▲ */
  { label: 'GitHub', href: SITE.repo },
];

/* ▼ FEATURE:projects ▼ */
import { PROJECTS } from '../../lib/paths.ts';
/* ▲ FEATURE:projects ▲ */
/* ▼ FEATURE:publications ▼ */
import { PUBLICATIONS } from '../../lib/paths.ts';
const pubs = await getCollection('publications');
/* ▲ FEATURE:publications ▲ */
/* ▼ FEATURE:people ▼ */
import { PEOPLE } from '../../lib/paths.ts';
const people = await getCollection('people');
/* ▲ FEATURE:people ▲ */
/* ▼ FEATURE:citations ▼ */
import { scholarMetrics } from '../../lib/citations.ts';
const m = scholarMetrics();
/* ▲ FEATURE:citations ▲ */

/*
 * Counted, never typed in — same reasoning as PersonHero.astro. A group page
 * that says "12 people" by hand is wrong the day someone joins, and nothing
 * would tell you.
 *
 * One row per line and each fenced by the feature it counts, so pruning that
 * feature takes its row — and its `getCollection` above — with it. Without the
 * fences a hero kept alongside a custom selection reads a collection that is
 * no longer declared, which is a build failure rather than a missing stat.
 */
const stats = [
  /* ▼ FEATURE:publications ▼ */
  { value: pubs.length, label: 'publications', href: PUBLICATIONS },
  /* ▲ FEATURE:publications ▲ */
  /* ▼ FEATURE:citations ▼ */
  { value: m.total, label: 'citations', href: PUBLICATIONS },
  { value: m.hIndex, label: 'h-index', href: PUBLICATIONS },
  /* ▲ FEATURE:citations ▲ */
  /* ▼ FEATURE:people ▼ */
  { value: people.length, label: 'people', href: PEOPLE },
  /* ▲ FEATURE:people ▲ */
].filter((s) => s.value > 0);
---

<section class="wrap hero">
  <img class="logo" src={logo} alt="" width={logoWidth} height={logoHeight} />
  <h1>{SITE.title}</h1>
  <p class="tagline">{SITE.tagline}</p>
  <p class="actions">
    {
      actions.map((a) => (
        <a
          class:list={['chip', a.primary && 'primary']}
          href={a.href}
          rel={a.href.startsWith('http') ? 'noopener' : undefined}
        >
          {a.label}
        </a>
      ))
    }
  </p>

  {
    stats.length > 0 && (
      <ul class="stats">
        {stats.map((s) => (
          <li>
            <a href={s.href}>
              <span class="stat-value">{formatCount(s.value)}</span>
              <span class="stat-label mono">{s.label}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(2.5rem, 7vw, 5rem) 0;
  }
  .logo {
    width: auto;
    height: clamp(4.5rem, 10vw, 6rem);
    margin-bottom: 1.5rem;
  }
  h1 {
    margin-bottom: 0.35rem;
  }
  .tagline {
    max-width: 42ch;
    margin: 0 0 1.5rem;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 0;
  }
  .chip.primary {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }

  /* Same hairline idiom as PersonHero.astro's stats row — a rule over each
     figure rather than a boxed tile, centred here to match the hero above it. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    max-width: 40rem;
    width: 100%;
  }
  .stats a {
    display: grid;
    gap: 0.1rem;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .stats a:hover {
    border-top-color: var(--sec-line);
  }
  .stats a:hover .stat-label {
    color: var(--sec);
  }
  .stat-value {
    font-family: var(--font-head);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--sec);
  }
  .stat-label {
    color: var(--text-faint);
    font-size: 0.6875rem;
  }
</style>
