---
/**
 * Links between the two entry-page shapes of src/pages/index.astro (the
 * second URL renders it with shape="project"), so a visitor can compare the
 * two ▼ PRESET:… ▼ regions `npm run init` chooses between. Plain links, so it
 * works with JS off. Belongs to the `demo` feature, which no preset includes.
 */
interface Props {
  /** Which shape src/pages/index.astro is rendering. */
  current: 'profile' | 'project';
}

const { current } = Astro.props;

/* The ids are the PRESET fence names, not free text. */
const sides = [
  { id: 'profile', label: 'Personal Academic Page', href: '/' },
  { id: 'project', label: 'Academic Project Page', href: '/demo/project/' },
] as const;
---

<p class="switch">
  <span class="note mono">demo — two entry pages, one template:</span>
  {
    sides.map((s) => (
      <a class="chip" href={s.href} aria-current={s.id === current ? 'page' : undefined}>
        {s.label}
      </a>
    ))
  }
  <span class="note mono">— gone after <code>npm run init</code></span>
</p>

<style>
  .switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    margin: 1.25rem auto 0;
    max-width: var(--max);
    padding-inline: var(--gutter);
  }
  .note {
    color: var(--text-faint);
    font-size: var(--fs-mono);
  }
  .note code {
    font-size: 0.9em;
  }
  /* The current side is picked out by colour, not by a box around the control. */
  .switch .chip[aria-current='page'] {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
</style>
