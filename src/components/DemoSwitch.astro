---
/**
 * The demo ships two interchangeable heroes — see src/components/hero/ — and
 * a visitor who only ever sees the one src/pages/index.astro happens to import
 * has no way to notice the other exists. This switcher sits above both entry
 * pages so a click is enough to compare them.
 *
 * Plain links, not a client-side toggle: each side is a real page Astro has
 * already rendered, so this has to work with JavaScript off. Gone the moment
 * `npm run init` runs — the fence around it is named `demo`, which is not a
 * feature in scripts/features.mjs because it has nothing to do with either
 * preset. Once you have picked a page, delete src/pages/demo/ and this file.
 */
interface Props {
  /** Which entry page is rendering this instance. */
  current: 'person' | 'project';
}

const { current } = Astro.props;

const sides = [
  { id: 'person', label: 'Personal Academic Page', href: '/' },
  { id: 'project', label: 'Academic Project Page', href: '/demo/project/' },
] as const;
---

<p class="switch">
  <span class="note mono">demo — two entry pages, one template:</span>
  {
    sides.map((s) => (
      <a class="chip" href={s.href} aria-current={s.id === current ? 'page' : undefined}>
        {s.label}
      </a>
    ))
  }
  <span class="note mono">— gone after <code>npm run init</code></span>
</p>

<style>
  .switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    margin: 1.25rem auto 0;
    max-width: var(--max);
    padding-inline: var(--gutter);
  }
  .note {
    color: var(--text-faint);
    font-size: var(--fs-mono);
  }
  .note code {
    font-size: 0.9em;
  }
  /* Same hairline idiom as the rest of the site's chips: the current side is
     picked out by colour, not by a box around the whole control. */
  .switch .chip[aria-current='page'] {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
</style>
