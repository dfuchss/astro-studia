---
/**
 * The demo ships two entry-page shapes — see the ▼ PRESET:… ▼ fences in
 * src/pages/index.astro — and a visitor who only ever lands on one of them has
 * no way to notice the other exists. This switcher sits above both so a click
 * is enough to compare them.
 *
 * Plain links, not a client-side toggle: each side is a real page Astro has
 * already rendered, so this has to work with JavaScript off. Both are
 * src/pages/index.astro — the second URL renders it with shape="project" —
 * so what the two buttons compare is the two ▼ PRESET:… ▼ regions of one file,
 * which is exactly what `npm run init` chooses between.
 *
 * Gone the moment init runs: this and src/pages/demo/ belong to the `demo`
 * feature, which no preset includes.
 */
interface Props {
  /** Which shape src/pages/index.astro is rendering. */
  current: 'profile' | 'project';
}

const { current } = Astro.props;

/*
 * The ids are the PRESET fence names in src/pages/index.astro, not free text:
 * `init --preset <id>` is what turns the side you pick into the only side.
 */
const sides = [
  { id: 'profile', label: 'Personal Academic Page', href: '/' },
  { id: 'project', label: 'Academic Project Page', href: '/demo/project/' },
] as const;
---

<p class="switch">
  <span class="note mono">demo — two entry pages, one template:</span>
  {
    sides.map((s) => (
      <a class="chip" href={s.href} aria-current={s.id === current ? 'page' : undefined}>
        {s.label}
      </a>
    ))
  }
  <span class="note mono">— gone after <code>npm run init</code></span>
</p>

<style>
  .switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.6rem;
    margin: 1.25rem auto 0;
    max-width: var(--max);
    padding-inline: var(--gutter);
  }
  .note {
    color: var(--text-faint);
    font-size: var(--fs-mono);
  }
  .note code {
    font-size: 0.9em;
  }
  /* Same hairline idiom as the rest of the site's chips: the current side is
     picked out by colour, not by a box around the whole control. */
  .switch .chip[aria-current='page'] {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
</style>
