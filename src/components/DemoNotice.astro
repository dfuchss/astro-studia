---
// Renders nothing once SITE.demoNotice is null. Two shapes: a banner for the
// top of the home page, and a single line for the footer.
import { SITE } from '../consts.ts';

interface Props {
  variant?: 'banner' | 'line';
}

const { variant = 'banner' } = Astro.props;
---

{
  SITE.demoNotice &&
    (variant === 'banner' ? (
      <aside class="banner wrap" aria-label="About this site">
        <p>
          <strong>This is a template demo.</strong> {SITE.demoNotice} Start by editing{' '}
          <code>src/consts.ts</code> — see <a href={SITE.repo}>the README</a>.
        </p>
      </aside>
    ) : (
      <p class="line mono">
        Demo content · <a href={SITE.repo}>Studia Theme</a>
      </p>
    ))
}

<style>
  .banner {
    display: block;
    margin-block: 1.25rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--warn);
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--warn) 10%, transparent);
    font-size: var(--fs-small);
    /* Narrower than --max, so it reads as an annotation rather than as the page. */
    max-width: var(--measure);
  }
  .banner p {
    margin: 0;
    color: var(--text-muted);
  }
  .banner strong {
    color: var(--text);
  }
  .banner code {
    font-size: 0.9em;
  }

  .line {
    margin: 0;
    color: var(--warn);
  }
  .line a {
    color: inherit;
  }
</style>
