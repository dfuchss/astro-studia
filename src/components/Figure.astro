---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** An image from src/assets/, as `image()` in the collection schema yields
      it — so the width, height and format below come from the build. */
  src: ImageMetadata;
  alt: string;
  /** A white plate behind the image: dark line art on transparency is close
      to invisible here. False for an image with its own background. */
  plate?: boolean;
  /** A window frame with this titlebar label, for a diagram or a screenshot.
      Off by default: framing a photo or a plot claims something untrue. */
  frame?: string;
  caption?: string;
}

const { src, alt, plate = true, frame, caption } = Astro.props;

/* Vectors are capped at the prose measure, so a small wide diagram does not
   dwarf its text; rasters at their own pixel width, past which they go soft. */
const isVector = src.format === 'svg';
const maxWidth = isVector ? 'var(--measure)' : `${src.width}px`;
---

<figure
  class:list={['figure', plate && 'has-plate', frame && 'framed']}
  style={`--fig-max: ${maxWidth}`}
>
  {
    /* The wrapper is here whether or not the figure is framed, so that there is
       one <img> in this file rather than one per branch. Unstyled it is an inert
       block div and the unframed figure renders exactly as it did before. */
  }
  <div class="frame">
    {
      frame && (
        <div class="frame-bar" aria-hidden="true">
          <span class="dot" />
          <span class="dot" />
          <span class="dot" />
          <span class="frame-label mono">{frame}</span>
        </div>
      )
    }
    <Image
      src={src}
      alt={alt}
      width={src.width}
      height={src.height}
      loading="lazy"
      decoding="async"
    />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .figure {
    max-width: min(100%, var(--fig-max));
    margin: 0 auto 1.75rem;
  }
  .figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-m);
    border: 1px solid var(--border);
  }
  .has-plate img {
    background: #fff;
    padding: 0.9rem;
  }

  /* The frame owns the border, the corners and the clipping, so the image gives
     all three up — a rounded border inside a rounded border is two frames. */
  .framed .frame {
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--bg-2);
    box-shadow: 0 20px 45px -30px var(--sec-glow);
  }
  .framed img {
    border: 0;
    border-radius: 0;
  }
  .framed.has-plate img {
    /* A hair more than the unframed plate, because here the white runs to the
       frame's inside edge and needs the margin to read as a page. */
    padding: 1rem;
  }
  .frame-bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.7rem;
    background: var(--bg-3);
    border-bottom: 1px solid var(--border);
  }
  /* Decoration, and aria-hidden on the bar for that reason: three dots and a
     window title say nothing a screen reader needs, and the alt text already
     says what the image is. */
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .frame-label {
    margin-left: 0.5rem;
    color: var(--text-faint);
    font-size: 0.6875rem;
  }
  figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-faint);
    text-align: center;
  }
</style>
