---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../../consts.ts';
import { routePath } from '../../lib/paths.ts';

interface Props {
  pub: CollectionEntry<'publications'>;
}
const { pub } = Astro.props;
const d = pub.data;

/*
 * Highwire Press citation_* tags plus a ScholarlyArticle JSON-LD block, which
 * is how Scholar and DBLP discover a paper page. Injected through Base's
 * `slot="head"`. citation_pdf_url only when you host the PDF yourself:
 * Scholar follows it expecting a PDF, so a landing page is worse than nothing.
 */
const container = d.booktitle ?? d.journal;
const date = d.month ? `${d.year}/${String(d.month).padStart(2, '0')}` : String(d.year);
// routePath(), as in BaseHead: under URL_POLICY 'preserve' the pathname is
// this page's FILE ("/papers/foo.html"), not its address.
const pageUrl = new URL(routePath(Astro.url.pathname), SITE.url).href;
/* Concatenated, not new URL(): d.pdfUrl is root-absolute, and resolving it
   against a SITE.url that ends "/astro-studia" drops it. */
const pdfUrl = d.pdfUrl && `${SITE.url.replace(/\/$/, '')}${d.pdfUrl}`;
/*
 * Page ranges reach us as "44–55": the parser has already turned the BibTeX
 * `--` into an en dash. Split on any of the three dashes it might use so a
 * single-page entry (`pages = {24}`) simply yields no last page.
 */
const DASHES = /\s*[–—-]\s*/;
const [firstPage, lastPage] = (d.pages ?? '').split(DASHES);
---

<meta name="citation_title" content={d.title} />
{d.authors.map((a) => <meta name="citation_author" content={`${a.last}, ${a.first}`} />)}
<meta name="citation_publication_date" content={date} />
{container && <meta name="citation_conference_title" content={container} />}
{d.journal && <meta name="citation_journal_title" content={d.journal} />}
{d.publisher && <meta name="citation_publisher" content={d.publisher} />}
{d.doi && <meta name="citation_doi" content={d.doi} />}
{d.volume && <meta name="citation_volume" content={d.volume} />}
{firstPage && <meta name="citation_firstpage" content={firstPage} />}
{lastPage && <meta name="citation_lastpage" content={lastPage} />}
{pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
<meta name="citation_abstract_html_url" content={pageUrl} />

<script
  is:inline
  type="application/ld+json"
  set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ScholarlyArticle',
    headline: d.title,
    name: d.title,
    author: d.authors.map((a) => ({ '@type': 'Person', name: `${a.first} ${a.last}`.trim() })),
    datePublished: String(d.year),
    isPartOf: container ? { '@type': 'PublicationEvent', name: container } : undefined,
    publisher: d.publisher ? { '@type': 'Organization', name: d.publisher } : undefined,
    identifier: d.doi ? `https://doi.org/${d.doi}` : undefined,
    url: pageUrl,
    isAccessibleForFree: true,
    sourceOrganization: { '@type': 'Organization', name: SITE.title, url: SITE.url },
  })}
/>
