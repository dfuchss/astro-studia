---
import { getEntry } from 'astro:content';
import type { DataEntryMap } from 'astro:content';

interface Props {
  /** The publication's `abbr` reference, or undefined for an entry with none. */
  abbr: { collection: 'venues'; id: string } | undefined;
}

const { abbr } = Astro.props;

const venue: DataEntryMap['venues'][string] | undefined = abbr ? await getEntry(abbr) : undefined;
---

{
  venue &&
    (venue.data.url ? (
      <a
        class="venue"
        href={venue.data.url}
        style={`--brand: ${venue.data.color}`}
        title={`${venue.data.name} (${venue.id})`}
        rel="noopener"
      >
        {venue.id}
      </a>
    ) : (
      /* A venue with no series page of its own — a thesis, a tech report —
         still gets a badge, just not a link. */
      <span class="venue" style={`--brand: ${venue.data.color}`} title={venue.data.name}>
        {venue.id}
      </span>
    ))
}

<style>
  /*
   * venues.yml holds each venue's real brand colour, used as-is. Many of those
   * were chosen against a white conference site and are far too dark to read
   * as text on a near-black page, so the raw hue only ever becomes the border
   * and a low-alpha fill; the text is mixed toward white until it is legible.
   *
   * That is why you can paste a venue's actual hex in and not think about it.
   */
  .venue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.5rem;
    padding: 0.3em 0.6em;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--brand) 55%, transparent);
    border-radius: var(--radius-s);
    background: color-mix(in srgb, var(--brand) 16%, transparent);
    color: color-mix(in srgb, var(--brand) 45%, white);
    transition: background var(--dur) var(--ease);
  }
  a.venue:hover {
    background: color-mix(in srgb, var(--brand) 30%, transparent);
  }
</style>
