---
import { getEntry } from 'astro:content';
import type { DataEntryMap } from 'astro:content';

interface Props {
  /** The publication's `abbr` reference, or undefined for an entry with none. */
  abbr: { collection: 'venues'; id: string } | undefined;
}

const { abbr } = Astro.props;

const venue: DataEntryMap['venues'][string] | undefined = abbr ? await getEntry(abbr) : undefined;
---

{
  venue &&
    (venue.data.url ? (
      <a
        class="venue"
        href={venue.data.url}
        style={`--brand: ${venue.data.color}`}
        title={`${venue.data.name} (${venue.id})`}
        rel="noopener"
      >
        {venue.id}
      </a>
    ) : (
      /* A venue with no series page of its own — a thesis, a tech report —
         still gets a badge, just not a link. */
      <span class="venue" style={`--brand: ${venue.data.color}`} title={venue.data.name}>
        {venue.id}
      </span>
    ))
}

<style>
  /* venues.yml holds each venue's real brand colour, usually chosen for a
     white site: the raw hue becomes the border and a low-alpha fill, and the
     text is mixed toward white until legible.

     --brand arrives inline per badge and is never defined in CSS, hence the
     fallback: with `publications` off this rule still ships — Astro bundles an
     imported component's styles whether or not it renders — and the audit is
     right to fail a var() nothing defines. Prose.astro's --ti does the same. */
  .venue {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 4.5rem;
    padding: 0.3em 0.6em;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--brand, var(--sec)) 55%, transparent);
    border-radius: var(--radius-s);
    background: color-mix(in srgb, var(--brand, var(--sec)) 16%, transparent);
    color: color-mix(in srgb, var(--brand, var(--sec)) 45%, white);
    transition: background var(--dur) var(--ease);
  }
  a.venue:hover {
    background: color-mix(in srgb, var(--brand, var(--sec)) 30%, transparent);
  }
</style>
