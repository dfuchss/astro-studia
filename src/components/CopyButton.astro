---
/**
 * Copy-to-clipboard button for a `<pre>` elsewhere on the page.
 *
 * Deliberately NOT under components/pub/: that directory belongs to the
 * `publications` feature and is deleted with it, while /pgp-key/ uses this
 * button to copy an ASCII-armored key and has nothing to do with a
 * bibliography. A generic control owned by one optional area is a build error
 * waiting for the first person who prunes that area and keeps the other.
 *
 * Markup and handler live together, and the handler binds to every
 * `button[data-copy]` on the page rather than to one id. Put them in separate
 * places and you end up with a second copy of the logic on the next page that
 * needs a BibTeX block, and then two versions that drift.
 *
 * Ships `hidden` and is revealed by the script, so without JS there is no dead
 * control — only the `<pre>`, which is selectable anyway.
 */
interface Props {
  /** id of the `<pre>` whose text is copied. */
  target: string;
  /** Accessible name, restored after the confirmation. */
  label?: string;
}
const { target, label = 'Copy BibTeX' } = Astro.props;
---

<button class="chip copy" type="button" data-copy={target} aria-label={label} title={label} hidden>
  <svg class="i-copy" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
    <rect x="5.5" y="5.5" width="8" height="9" rx="1.5"></rect>
    <path d="M10.5 3.5h-7a1.5 1.5 0 0 0-1.5 1.5v7"></path>
  </svg>
  <svg class="i-done" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
    <path d="M3 8.5l3.2 3.2L13 5"></path>
  </svg>
</button>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
    btn.hidden = false;
    // Read once, at bind time: a second click inside the confirmation window
    // would otherwise capture "Copied" as the name to restore.
    const label = btn.getAttribute('aria-label') ?? 'Copy';
    let restore: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      const pre = document.getElementById(btn.dataset.copy!);
      if (!pre?.textContent) return;
      await navigator.clipboard.writeText(pre.textContent);
      // Icon-only, so the confirmation is a swapped icon plus the accessible
      // name. There is no text node to replace.
      btn.classList.add('is-copied');
      btn.setAttribute('aria-label', 'Copied');
      clearTimeout(restore);
      restore = setTimeout(() => {
        btn.classList.remove('is-copied');
        btn.setAttribute('aria-label', label);
      }, 1200);
    });
  }
</script>

<style>
  .copy {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    z-index: 1;
    cursor: pointer;
    background: var(--bg-3);
    box-shadow: 0 0 0 4px var(--bg-1);
    /* Icon-only: the chip is square, and the label lives in aria-label/title. */
    padding: 0.4em;
    line-height: 0;
  }
  .copy:hover {
    border-color: var(--sec-line);
    color: var(--sec-strong);
  }
  .copy svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .copy .i-done,
  .copy.is-copied .i-copy {
    display: none;
  }
  .copy.is-copied .i-done {
    display: block;
  }
  .copy.is-copied {
    border-color: var(--sec-line);
    color: var(--sec);
  }
</style>
