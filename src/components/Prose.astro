---
/**
 * Wrapper for rendered markdown.
 *
 * The only place in this codebase with `is:global` styles, and necessarily so:
 * these target remark's output, which Astro's scoped-style attributes never
 * reach. Everything is under `.prose`, so nothing here leaks into a component.
 */
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    max-width: var(--measure);
  }
  .prose > :first-child {
    margin-top: 0;
  }

  .prose h2 {
    margin-top: 2.25rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }
  /* h3 and h4 take the section accent and the muted ink respectively, so a
     long post has three visibly distinct heading levels without needing three
     distinct sizes. */
  .prose h3 {
    margin-top: 1.75rem;
    color: var(--sec-strong);
  }
  .prose h4 {
    margin-top: 1.25rem;
    font-size: 1rem;
    color: var(--text-muted);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }
  /* Spacing BETWEEN items only, so a list does not gain a trailing gap that
     the paragraph after it then doubles. */
  .prose li + li {
    margin-top: 0.3rem;
  }
  .prose li::marker {
    color: var(--sec);
  }

  /* A ruled quote, not a filled callout. A tinted panel reads as an admonition
     — "note the following" — which is a different thing from quoting someone. */
  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 2px solid var(--sec-line);
    color: var(--text-muted);
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  /*
   * Screenshots get the "screen in a frame" treatment: a layered surface, a
   * soft hue halo and a hairline highlight, so a light-UI screenshot does not
   * float unanchored on a near-black page.
   */
  .prose :is(p, figure) > img {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    background: var(--bg-2);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--sec) 10%, transparent),
      0 18px 40px -24px var(--sec-glow),
      0 2px 10px rgb(0 0 0 / 35%);
  }
  /* An SVG in body copy is usually dark-on-transparent line art, invisible
     here unplated, so plating is the default. `class="no-plate"` opts out;
     markdown's ![](…) cannot express that (nor width/height), so write the
     <img> tag — see docs/Content.md, "Images in a post". */
  .prose :is(p, figure) > img[src$='.svg']:not(.no-plate) {
    background: #fff;
    padding: 1rem;
  }
  .prose figure {
    margin: 1.75rem 0;
  }
  .prose figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-faint);
    text-align: center;
  }

  /* A before/after pair (markup in docs/Content.md). Each image links to its
     own file, because two screenshots at half the measure are only useful
     opened. Deliberately outside the plate-and-halo rules above, which match
     only an <img> that is a direct child of a <p> or <figure>: two glowing
     panels side by side read as two figures rather than one comparison. */
  .prose .compare {
    margin: 1.75rem 0;
  }
  .prose .compare-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  /* The anchor is the image's box: line-height 0 keeps the inline baseline's
     descender gap from showing up as a stripe under each screenshot. */
  .prose .compare a {
    display: block;
    line-height: 0;
  }
  .prose .compare img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    transition: border-color var(--dur) var(--ease);
  }
  /* The only affordance saying these are clickable, so it is on the border
     rather than on the image — a hover that dims or scales a screenshot makes
     the thing you are trying to look at harder to see. */
  .prose .compare a:hover img {
    border-color: var(--sec-line);
  }
  .prose .compare figcaption {
    line-height: 1.5;
  }
  @media (max-width: 40rem) {
    .prose .compare-pair {
      grid-template-columns: 1fr;
    }
  }

  /* An inline icon: a 24x24 SVG with `class="ti"` (markup in docs/Content.md),
     tinted per icon through `--ti` and otherwise the muted ink. Keep
     width/height on the tag too: a browser with CSS still loading otherwise
     lays the icon out at 300x150. */
  .prose .ti {
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.18em;
    color: var(--ti, var(--text-faint));
    flex: none;
  }

  /* An icon-led list (markup in docs/Content.md). The leading icon replaces
     the bullet, and the links row is indented to the text's left edge. */
  .prose ul.tool-landscape {
    padding-left: 0;
    list-style: none;
  }
  .prose ul.tool-landscape > li + li {
    margin-top: 1.1rem;
  }
  .prose ul.tool-landscape > li > .ti:first-child {
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.4em;
  }
  .prose .tool-links {
    display: inline-block;
    margin-left: 1.6em;
    font-size: var(--fs-small);
  }

  /* A wide table scrolls inside its own box, never the page body. */
  .prose table {
    display: block;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /* For an embedded video: <div class="video"><iframe …></iframe></div>.
     Note that an embed is a third-party origin, so its host has to be listed
     in ALLOWED_THIRD_PARTY in src/consts.ts or the audit fails the build. */
  .prose .video {
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--bg-1);
  }
  .prose .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
