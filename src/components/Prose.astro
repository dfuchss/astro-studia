---
/**
 * Wrapper for rendered markdown.
 *
 * The only place in this codebase with `is:global` styles, and necessarily so:
 * these target remark's output, which Astro's scoped-style attributes never
 * reach. Everything is under `.prose`, so nothing here leaks into a component.
 */
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    max-width: var(--measure);
  }
  .prose > :first-child {
    margin-top: 0;
  }

  .prose h2 {
    margin-top: 2.25rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }
  /* h3 and h4 take the section accent and the muted ink respectively, so a
     long post has three visibly distinct heading levels without needing three
     distinct sizes. */
  .prose h3 {
    margin-top: 1.75rem;
    color: var(--sec-strong);
  }
  .prose h4 {
    margin-top: 1.25rem;
    font-size: 1rem;
    color: var(--text-muted);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }
  /* Spacing BETWEEN items only, so a list does not gain a trailing gap that
     the paragraph after it then doubles. */
  .prose li + li {
    margin-top: 0.3rem;
  }
  .prose li::marker {
    color: var(--sec);
  }

  /* A ruled quote, not a filled callout. A tinted panel reads as an admonition
     — "note the following" — which is a different thing from quoting someone. */
  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 2px solid var(--sec-line);
    color: var(--text-muted);
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  /*
   * Screenshots get the "screen in a frame" treatment: a layered surface, a
   * soft hue halo and a hairline highlight, so a light-UI screenshot does not
   * float unanchored on a near-black page.
   */
  .prose :is(p, figure) > img {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    background: var(--bg-2);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--sec) 10%, transparent),
      0 18px 40px -24px var(--sec-glow),
      0 2px 10px rgb(0 0 0 / 35%);
  }
  /* An SVG in body copy is usually the same dark-on-transparent line art that
     Figure.astro plates, and on this background it would otherwise be close to
     invisible. Plating is therefore the default, because the failure it
     prevents is silent.

     Escape hatch for a figure that carries its own background:
       <img class="no-plate" src="…" width="760" height="300" alt="…">

     Markdown's own ![](…) cannot express that, and cannot carry width and
     height either — which the build's image audit requires. So write an <img>
     tag directly in the .md when you need one; it is plain HTML and remark
     passes it through untouched. */
  .prose :is(p, figure) > img[src$='.svg']:not(.no-plate) {
    background: #fff;
    padding: 1rem;
  }
  .prose figure {
    margin: 1.75rem 0;
  }
  .prose figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-faint);
    text-align: center;
  }

  /* A wide table scrolls inside its own box, never the page body. */
  .prose table {
    display: block;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /* For an embedded video: <div class="video"><iframe …></iframe></div>.
     Note that an embed is a third-party origin, so its host has to be listed
     in ALLOWED_THIRD_PARTY in src/consts.ts or the audit fails the build. */
  .prose .video {
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--bg-1);
  }
  .prose .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
