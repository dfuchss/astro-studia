---
/**
 * Wrapper for rendered markdown.
 *
 * The only place in this codebase with `is:global` styles, and necessarily so:
 * these target remark's output, which Astro's scoped-style attributes never
 * reach. Everything is under `.prose`, so nothing here leaks into a component.
 */
---

<div class="prose"><slot /></div>

<style is:global>
  .prose {
    max-width: var(--measure);
  }
  .prose > :first-child {
    margin-top: 0;
  }

  .prose h2 {
    margin-top: 2.25rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }
  /* h3 and h4 take the section accent and the muted ink respectively, so a
     long post has three visibly distinct heading levels without needing three
     distinct sizes. */
  .prose h3 {
    margin-top: 1.75rem;
    color: var(--sec-strong);
  }
  .prose h4 {
    margin-top: 1.25rem;
    font-size: 1rem;
    color: var(--text-muted);
  }

  .prose ul,
  .prose ol {
    padding-left: 1.25rem;
  }
  /* Spacing BETWEEN items only, so a list does not gain a trailing gap that
     the paragraph after it then doubles. */
  .prose li + li {
    margin-top: 0.3rem;
  }
  .prose li::marker {
    color: var(--sec);
  }

  /* A ruled quote, not a filled callout. A tinted panel reads as an admonition
     — "note the following" — which is a different thing from quoting someone. */
  .prose blockquote {
    margin: 1.5rem 0;
    padding: 0.25rem 0 0.25rem 1.1rem;
    border-left: 2px solid var(--sec-line);
    color: var(--text-muted);
  }
  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  /*
   * Screenshots get the "screen in a frame" treatment: a layered surface, a
   * soft hue halo and a hairline highlight, so a light-UI screenshot does not
   * float unanchored on a near-black page.
   */
  .prose :is(p, figure) > img {
    display: block;
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    background: var(--bg-2);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--sec) 10%, transparent),
      0 18px 40px -24px var(--sec-glow),
      0 2px 10px rgb(0 0 0 / 35%);
  }
  /* An SVG in body copy is usually the same dark-on-transparent line art that
     Figure.astro plates, and on this background it would otherwise be close to
     invisible. Plating is therefore the default, because the failure it
     prevents is silent.

     Escape hatch for a figure that carries its own background:
       <img class="no-plate" src="…" width="760" height="300" alt="…">

     Markdown's own ![](…) cannot express that, and cannot carry width and
     height either — which the build's image audit requires. So write an <img>
     tag directly in the .md when you need one; it is plain HTML and remark
     passes it through untouched. */
  .prose :is(p, figure) > img[src$='.svg']:not(.no-plate) {
    background: #fff;
    padding: 1rem;
  }
  .prose figure {
    margin: 1.75rem 0;
  }
  .prose figcaption {
    margin-top: 0.6rem;
    font-size: var(--fs-small);
    color: var(--text-faint);
    text-align: center;
  }

  /*
   * A before/after pair, side by side:
   *
   *   <figure class="compare">
   *     <div class="compare-pair">
   *       <a href="/assets/img/…/before.svg"><img src="…" width="…" height="…" alt="…"></a>
   *       <a href="/assets/img/…/after.svg"><img src="…" width="…" height="…" alt="…"></a>
   *     </div>
   *     <figcaption>What changed. Click either for full size.</figcaption>
   *   </figure>
   *
   * Each image links to its own file, because two screenshots at half the
   * reading measure are too small to read and the only useful thing to do with
   * one is open it. They stack below 40rem, where half a column is no longer a
   * screenshot but a smudge.
   *
   * The images here are deliberately outside the plate-and-halo treatment
   * below: those rules only match an <img> that is a direct child of a <p> or a
   * <figure>, and these sit inside the grid and their links. A pair wants a
   * hairline and nothing more — two glowing panels side by side read as two
   * separate figures rather than one comparison.
   */
  .prose .compare {
    margin: 1.75rem 0;
  }
  .prose .compare-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  /* The anchor is the image's box: line-height 0 keeps the inline baseline's
     descender gap from showing up as a stripe under each screenshot. */
  .prose .compare a {
    display: block;
    line-height: 0;
  }
  .prose .compare img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius-s);
    transition: border-color var(--dur) var(--ease);
  }
  /* The only affordance saying these are clickable, so it is on the border
     rather than on the image — a hover that dims or scales a screenshot makes
     the thing you are trying to look at harder to see. */
  .prose .compare a:hover img {
    border-color: var(--sec-line);
  }
  .prose .compare figcaption {
    line-height: 1.5;
  }
  @media (max-width: 40rem) {
    .prose .compare-pair {
      grid-template-columns: 1fr;
    }
  }

  /*
   * An inline icon, written into the markdown as a 24x24 SVG with
   * `class="ti"`:
   *
   *   <svg class="ti" width="20" height="20" style="--ti: #5cc8e8"
   *        viewBox="0 0 24 24" fill="none" stroke="currentColor"
   *        stroke-width="1.75" aria-hidden="true"><path d="…"/></svg>
   *
   * Sized in em so it tracks whatever text it sits in, and coloured through
   * one custom property so a body can tint an icon per row without a class per
   * colour. The fallback is the muted ink, which is what an untinted icon
   * should be: an icon is decoration next to a label, and every one of them
   * shouting in an accent colour is noise.
   *
   * `width`/`height` attributes stay on the tag as well — the audit does not
   * require them on an <svg>, but a browser with CSS still loading otherwise
   * lays the icon out at 300x150.
   *
   * There is no icon dependency here on purpose. Take the path data from
   * whatever set you like and paste it in; that is the whole mechanism.
   */
  .prose .ti {
    width: 1.05em;
    height: 1.05em;
    vertical-align: -0.18em;
    color: var(--ti, var(--text-faint));
    flex: none;
  }

  /*
   * An icon-led list, for a set of things each of which has a name, a sentence
   * and somewhere to go:
   *
   *   <ul class="tool-landscape">
   *     <li>
   *       <svg class="ti" style="--ti: #5cc8e8" …/>
   *       <strong>Name</strong> — what it is.<br>
   *       <span class="tool-links"><svg class="ti" …/> <a href="…">Link</a></span>
   *     </li>
   *   </ul>
   *
   * The leading icon replaces the bullet, so the list loses its marker and its
   * indent. The links row is indented to the text's left edge instead of the
   * icon's, which is what keeps the column of names readable when several rows
   * each carry a link run.
   *
   * Spacing is between items rather than after each one, matching the `li + li`
   * rule above — a trailing gap on the last row doubles with the margin of
   * whatever paragraph follows.
   */
  .prose ul.tool-landscape {
    padding-left: 0;
    list-style: none;
  }
  .prose ul.tool-landscape > li + li {
    margin-top: 1.1rem;
  }
  .prose ul.tool-landscape > li > .ti:first-child {
    width: 1.2em;
    height: 1.2em;
    margin-right: 0.4em;
  }
  .prose .tool-links {
    display: inline-block;
    margin-left: 1.6em;
    font-size: var(--fs-small);
  }

  /* A wide table scrolls inside its own box, never the page body. */
  .prose table {
    display: block;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }

  /* For an embedded video: <div class="video"><iframe …></iframe></div>.
     Note that an embed is a third-party origin, so its host has to be listed
     in ALLOWED_THIRD_PARTY in src/consts.ts or the audit fails the build. */
  .prose .video {
    aspect-ratio: 16 / 9;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--bg-1);
  }
  .prose .video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
