---
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Prose from '../../../components/Prose.astro';
import Figure from '../../../components/Figure.astro';
import VenueBadge from '../../../components/pub/VenueBadge.astro';
import ScholarMeta from '../../../components/pub/ScholarMeta.astro';
import CopyButton from '../../../components/pub/CopyButton.astro';
import { projectPath } from '../../../lib/paths.ts';
import { isSelf } from '../../../lib/authors.ts';

export const getStaticPaths = (async () => {
  const papers = await getCollection('papers');
  return papers.map((paper) => ({ params: { slug: paper.id }, props: { paper } }));
}) satisfies GetStaticPaths;

const { paper } = Astro.props;
const { Content } = await render(paper);

// Everything bibliographic comes from the BibTeX entry, never from this
// page's front matter — so a paper has exactly one source of truth for its
// venue, year and DOI, and they cannot drift apart.
const pub = await getEntry(paper.data.publication);
if (!pub) throw new Error(`${paper.id}: publication ${paper.data.publication.id} not found`);
const d = pub.data;

const authors = await Promise.all(paper.data.authors.map((ref) => getEntry(ref)));

/*
 * authors.yml holds one display name per person, while isSelf() matches on a
 * surname — so the surname is the last whitespace-separated word. That is right
 * for everyone except a compound name ("van der Aalst" reduces to "Aalst"), and
 * the fix when it bites is to list that spelling in SELF.surnames, which is
 * exactly what that list is for.
 */
const surname = (a: { name: string }) => a.name.split(/\s+/).at(-1) ?? a.name;

/*
 * The projects this paper came out of. The other direction of the same edge —
 * every paper on a project's page — is computed on /projects/<slug>/, so this
 * front matter is the only place the relationship is written down.
 *
 * A project with `redirect` has no page of its own, and linking to the path it
 * would have had is a 404 the build cannot see: reference() proves the entry
 * exists, not that a page was generated for it.
 */
const projects = (await Promise.all(paper.data.projects.map((ref) => getEntry(ref)))).map((p) => ({
  title: p.data.title,
  href: p.data.redirect ?? projectPath(p.id),
  external: Boolean(p.data.redirect),
}));

/**
 * Pretty names for the link keys used in front matter. A key with no entry
 * here falls back to itself, so adding a link never requires editing this —
 * it just renders as you typed it.
 */
const LINK_LABELS: Record<string, string> = {
  acm: 'ACM DL',
  ieee: 'IEEE Xplore',
  arxiv: 'arXiv',
  doi: 'DOI',
  pdf: 'PDF',
  preprint: 'Preprint',
  zenodo: 'Zenodo',
  repo: 'Repository',
  data: 'Data',
  loeb: 'Loeb',
  archive: 'Internet Archive',
  perseus: 'Perseus',
};
const label = (key: string) => LINK_LABELS[key] ?? key;

const linkRows = [
  { title: 'Paper', map: paper.data.links.paper },
  { title: 'Replication', map: paper.data.links.replication },
  { title: 'Slides', map: paper.data.links.slides },
].filter((row) => row.map && Object.keys(row.map).length > 0);

const inParts = [d.booktitle ?? d.journal ?? d.school ?? d.institution, d.location].filter(Boolean);

// The two links a reader actually came for. They are repeated further down in
// the link rows, which is the point: those rows are an index of everywhere the
// work lives, and nobody should have to read an index to find the PDF.
const hasActions = Boolean(d.pdfUrl || d.doi);

// The id CopyButton copies from, in the cite section below.
const bibId = `bib-${pub.id}`;
---

<Base title={paper.data.title} description={paper.data.description} section="papers">
  <ScholarMeta slot="head" pub={pub} />

  <article class="wrap section">
    <header class="head">
      <div class="meta">
        <VenueBadge abbr={d.abbr} />
        <span class="mono year">{d.year}</span>
        {
          /* Only the unpublished state is worth saying. A "published" badge on
             forty pages out of forty-one is noise that makes the one page that
             needs it harder to spot, not easier. */
          paper.data.status === 'to-appear' && <span class="chip status">to appear</span>
        }
      </div>

      <h1>{paper.data.title}</h1>

      {
        authors.length > 0 && (
          <p class="authors">
            {authors.map((a, i) => (
              <>
                {i > 0 && <span aria-hidden="true">, </span>}
                <span
                  class:list={['author', { self: isSelf({ first: '', last: surname(a.data) }) }]}
                >
                  {a.data.name}
                  {/*
                   * The badge is the link, not the name. A name that is a link
                   * promises the person's page; this one goes to a registry
                   * record, and the 4x16-digit identifier next to a name is the
                   * convention every publisher's author line already uses. It
                   * also leaves the name free to become a link to something of
                   * yours later without the two fighting.
                   */}
                  {a.data.orcid && (
                    <a
                      class="orcid"
                      href={`https://orcid.org/${a.data.orcid}`}
                      rel="noopener"
                      aria-label={`ORCID record for ${a.data.name}`}
                      title={`ORCID ${a.data.orcid}`}
                    >
                      iD
                    </a>
                  )}
                </span>
              </>
            ))}
          </p>
        )
      }

      {inParts.length > 0 && <p class="venue-line">{inParts.join(', ')}</p>}

      {
        paper.data.conferenceName && (
          <p class="conf">
            {paper.data.status === 'to-appear' ? 'To appear at' : 'Published at'}{' '}
            {paper.data.conferenceUrl ? (
              <a href={paper.data.conferenceUrl} rel="noopener">
                {paper.data.conferenceName}
              </a>
            ) : (
              <span>{paper.data.conferenceName}</span>
            )}
          </p>
        )
      }

      {
        paper.data.additionalPresentations.length > 0 && (
          <p class="conf">
            Also presented at{' '}
            {paper.data.additionalPresentations.map((p, i) => (
              <>
                {i > 0 && <span aria-hidden="true">, </span>}
                <a href={p.url} rel="noopener" title={p.shortName ? p.name : undefined}>
                  {p.shortName ?? p.name}
                </a>
              </>
            ))}
          </p>
        )
      }

      {
        hasActions && (
          <p class="actions">
            {d.pdfUrl && (
              <a class="chip primary" href={d.pdfUrl}>
                Read the PDF
              </a>
            )}
            {d.doi && (
              <a class="chip" href={`https://doi.org/${d.doi}`} rel="noopener">
                DOI
              </a>
            )}
          </p>
        )
      }
    </header>

    {
      paper.data.figure && (
        <Figure
          src={paper.data.figure.src}
          alt={paper.data.figure.alt}
          plate={paper.data.figure.plate}
          frame={paper.data.figure.frame}
        />
      )
    }

    <Prose>
      <Content />
    </Prose>

    {
      (projects.length > 0 || linkRows.length > 0) && (
        <section class="links" aria-label="Links">
          {projects.length > 0 && (
            <div class="row">
              <h2 class="mono row-title">Projects</h2>
              <div class="chips">
                {projects.map((p) => (
                  <a class="chip" href={p.href} rel={p.external ? 'noopener' : undefined}>
                    {p.title}
                    {p.external && <span aria-hidden="true">↗</span>}
                  </a>
                ))}
              </div>
            </div>
          )}
          {linkRows.map((row) => (
            <div class="row">
              <h2 class="mono row-title">{row.title}</h2>
              <div class="chips">
                {Object.entries(row.map!).map(([key, href]) => (
                  <a class="chip" href={href} rel="noopener">
                    {label(key)}
                  </a>
                ))}
              </div>
            </div>
          ))}
        </section>
      )
    }

    <section class="cite" aria-labelledby="cite-h">
      <h2 class="mono" id="cite-h">Cite</h2>
      {
        /* BibTeX alone, deliberately.
         *
         * This section held a full <PubEntry> for a while, on the theory that
         * the badge, authors and citation count tell you whether this is the
         * thing you meant to cite. On a page that opens with exactly that
         * header it repeats all of it a screen further down, and it buries the
         * one thing the section is FOR behind a disclosure toggle. It also
         * needed a rule to hide the entry's own "Paper page" chip, which
         * pointed at the page you were already on — a component needing to be
         * partly hidden is the component being wrong for the place.
         *
         * Both sites this template came from tried it and moved back. */
      }
      <div class="cite-body">
        <CopyButton target={bibId} />
        <pre id={bibId}>{d.bibtex}</pre>
      </div>
    </section>
  </article>
</Base>

<style>
  /* Header, figure, prose, links and the cite block all size to --measure, so
     their left and right edges line up the whole way down the page instead of
     each block picking its own width. */
  .head,
  .links,
  .cite {
    max-width: var(--measure);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.9rem;
  }
  .year {
    color: var(--text-faint);
  }
  .status {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  .authors,
  .venue-line,
  .conf {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .venue-line {
    font-style: italic;
  }
  /* The site's own author reads at full strength; the co-authors are context.
     Which one is "own" comes from SELF.surnames in src/consts.ts, so a group
     site that deletes SELF loses the emphasis and nothing else. */
  .author.self {
    color: var(--text);
    font-weight: 600;
  }
  /* The ORCID badge: the registry's own "iD" mark, small enough to read as a
     superscript on the name rather than as a second word in the author list.
     3px rather than --radius-s, because at this size the token's 8px is a pill. */
  .orcid {
    display: inline-block;
    margin-left: 0.35ch;
    padding: 0 0.3em;
    border: 1px solid var(--sec-line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    vertical-align: 0.15em;
    color: var(--sec);
    text-decoration: none;
  }
  .orcid:hover {
    background: var(--sec-dim);
  }

  /* The one emphatic element on the page, because it is the one thing most
     readers arrived to do. Everything else here is a hairline. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }
  .actions .primary {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }

  .links {
    margin-top: 2.5rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.7rem 0;
    border-top: 1px solid var(--border);
  }
  .row-title {
    /* Fixed column so the chip rows line up under one another, but allowed to
       wrap onto its own line before it squeezes them. */
    flex: 0 0 6rem;
    margin: 0;
    font-size: var(--fs-mono);
    font-weight: 500;
    color: var(--text-faint);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .cite {
    margin-top: 2.5rem;
  }
  .cite h2 {
    font-size: var(--fs-mono);
    font-weight: 500;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }
  .bare {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
