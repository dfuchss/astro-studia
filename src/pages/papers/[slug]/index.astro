---
import { getCollection, getEntry, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import Prose from '../../../components/Prose.astro';
import Figure from '../../../components/Figure.astro';
import VenueBadge from '../../../components/pub/VenueBadge.astro';
import ScholarMeta from '../../../components/pub/ScholarMeta.astro';
import CopyButton from '../../../components/CopyButton.astro';
import { PAPERS, projectPath } from '../../../lib/paths.ts';
import { isSelfName } from '../../../lib/authors.ts';
import {
  paperByline,
  paperPublication,
  paperVenue,
  paperVenueShort,
  paperYear,
} from '../../../lib/papers.ts';

export const getStaticPaths = (async () => {
  const papers = await getCollection('papers');
  return papers.map((paper) => ({ params: { slug: paper.id }, props: { paper } }));
}) satisfies GetStaticPaths;

const { paper } = Astro.props;
const { Content } = await render(paper);

/*
 * Everything bibliographic comes from the BibTeX entry, never from this page's
 * front matter — so a paper has exactly one source of truth for its venue,
 * year and DOI, and they cannot drift apart.
 *
 * `pub` is undefined for a page that has no entry at all: a talk at a venue
 * that publishes nothing. That is a legitimate page, and it is why every read
 * below is optional. A `publication` that is DECLARED and does not resolve is
 * still fatal — paperPublication() throws — because the page it would render
 * looks nearly right and the typo would reach the site.
 */
const pub = await paperPublication(paper);
const d = pub?.data;

const venue = paperVenue(paper);
const year = paperYear(paper, pub);

const authors = await Promise.all(paper.data.authors.map((ref) => getEntry(ref)));

/*
 * The projects this paper came out of. The other direction of the same edge —
 * every paper on a project's page — is computed on /projects/<slug>/, so this
 * front matter is the only place the relationship is written down.
 *
 * A project with `redirect` has no page of its own, and linking to the path it
 * would have had is a 404 the build cannot see: reference() proves the entry
 * exists, not that a page was generated for it.
 */
const projects = (await Promise.all(paper.data.projects.map((ref) => getEntry(ref)))).map((p) => ({
  title: p.data.title,
  href: p.data.redirect ?? projectPath(p.id),
  external: Boolean(p.data.redirect),
}));

/**
 * Pretty names for the link keys used in front matter. A key with no entry
 * here falls back to itself, so adding a link never requires editing this —
 * it just renders as you typed it.
 */
const LINK_LABELS: Record<string, string> = {
  acm: 'ACM DL',
  ieee: 'IEEE Xplore',
  arxiv: 'arXiv',
  doi: 'DOI',
  pdf: 'PDF',
  preprint: 'Preprint',
  zenodo: 'Zenodo',
  repo: 'Repository',
  data: 'Data',
  loeb: 'Loeb',
  archive: 'Internet Archive',
  perseus: 'Perseus',
};
const label = (key: string) => LINK_LABELS[key] ?? key;

// Lowercase because the column heads are set in mono and read as keys, not as
// sentences — the same voice as every other `.mono` label in the theme.
const linkRows = [
  { title: 'paper', map: paper.data.links.paper },
  { title: 'replication', map: paper.data.links.replication },
  { title: 'slides', map: paper.data.links.slides },
].filter((row) => row.map && Object.keys(row.map).length > 0);

const inParts = [d?.booktitle ?? d?.journal ?? d?.school ?? d?.institution, d?.location].filter(
  Boolean,
);

// The two links a reader actually came for. They are repeated further down in
// the link rows, which is the point: those rows are an index of everywhere the
// work lives, and nobody should have to read an index to find the PDF.
const hasActions = Boolean(d?.pdfUrl || d?.doi);

/*
 * The citation, and the id CopyButton copies from. One object rather than two
 * loose consts so the Cite section below has a single thing to test: either
 * there is a record to copy or there is a sentence saying why there is not.
 */
const cite = pub ? { id: `bib-${pub.id}`, bibtex: pub.data.bibtex } : undefined;

// The connector in front of the names and the separator between them, which are
// not the same in the derived and the stated case — see paperByline(). Shared
// with the paper rows on the entry pages rather than restated here.
const { connector, separator } = paperByline(venue, authors.length);
---

<Base title={paper.data.title} description={paper.data.description} section="papers">
  {
    pub && (
      <Fragment slot="head">
        <ScholarMeta pub={pub} />
      </Fragment>
    )
  }

  <article class="wrap section">
    <header class="head">
      {
        /* One line doing both jobs: where you are, and what this is. A separate
           breadcrumb above a venue kicker said the same thing twice in a row,
           and the slug it ended on ("de-re-publica") was the one part a reader
           already knows — they just clicked it. So the path's leaf is the venue
           label instead.

           The venue abbreviation is the shortest true name a published paper
           has, which is why the schema carries no separate short label for it:
           adding one would mean restating the badge in every paper's front
           matter. A page with no BibTeX entry has no badge to restate, so it
           names its venue in `venue.short`. A paper with neither is a preprint,
           which is what is left — see paperVenueShort(). */
      }
      <p class="kicker" data-sigil="none">
        <a href={PAPERS}>papers</a>
        <span aria-hidden="true">/</span>{' '}
        {paperVenueShort(paper, pub)}
      </p>

      <h1>{paper.data.title}</h1>

      {
        authors.length > 0 && (
          <p class="byline">
            {/* The trailing space is in the string: a space between two
                expressions is whitespace between markup nodes, and which of
                those survive is not something to bet a byline on. */}
            {connector && `${connector} `}
            {authors.map((a, i) => (
              <>
                {i > 0 && <span aria-hidden="true">{separator(i)}</span>}
                <span class:list={['author', { self: isSelfName(a.data.name) }]}>
                  {a.data.name}
                  {/*
                   * The badge is the link, not the name. A name that is a link
                   * promises the person's page; this one goes to a registry
                   * record, and the 4x16-digit identifier next to a name is the
                   * convention every publisher's author line already uses. It
                   * also leaves the name free to become a link to something of
                   * yours later without the two fighting.
                   */}
                  {a.data.orcid && (
                    <a
                      class="orcid"
                      href={`https://orcid.org/${a.data.orcid}`}
                      rel="noopener"
                      aria-label={`ORCID record for ${a.data.name}`}
                      title={`ORCID ${a.data.orcid}`}
                    >
                      iD
                    </a>
                  )}
                </span>
              </>
            ))}
          </p>
        )
      }

      {
        /* Badge, year and the venue sentence on one flex row: they are one
           fact — where this was published — and stacking them as three lines
           made the header read as a form with three fields. */
      }
      <p class="venue-line">
        <VenueBadge abbr={d?.abbr} />
        {year !== undefined && <span class="mono year">{year}</span>}
        {
          /* Plain text, not a pill. The sentence beside it already says
             "Published at X" or "To appear at X", and a pill repeating that is
             the same fact twice in one row. This only covers the case where
             there is no venue sentence to carry it — then the status has
             nowhere else to be said, and only the unpublished state is worth
             saying. */
          paper.data.status === 'to-appear' && !venue && <span>To appear</span>
        }
        {
          /* One sentence, two sources: "Published at <conference>" derived from
             the paper's BibTeX entry, or the label the page states itself —
             which is already a whole sentence, in its own language, and so gets
             no English prefix in front of it. See paperVenue(). */
          venue && (
            <span>
              {venue.mark && `${venue.mark} `}
              {venue.prefix && `${venue.prefix} `}
              {venue.url ? (
                <a href={venue.url} rel="noopener">
                  {venue.label}
                </a>
              ) : (
                venue.label
              )}
            </span>
          )
        }
      </p>

      {inParts.length > 0 && <p class="imprint">{inParts.join(', ')}</p>}

      {
        paper.data.additionalPresentations.length > 0 && (
          <p class="also">
            Also presented at{' '}
            {paper.data.additionalPresentations.map((p, i) => (
              <>
                {/* `additionalPresentations.length`, not `authors.length` —
                    this list is not the byline, and the two happening to be
                    the same length in the demo is what hid it. */}
                {i > 0 && (
                  <span aria-hidden="true">
                    {i === paper.data.additionalPresentations.length - 1 ? ', and ' : ', '}
                  </span>
                )}
                <a href={p.url} rel="noopener" title={p.shortName ? p.name : undefined}>
                  {p.shortName ?? p.name}
                </a>
              </>
            ))}
          </p>
        )
      }

      {
        hasActions && (
          <p class="actions">
            {d?.pdfUrl && (
              <a class="chip primary" href={d.pdfUrl}>
                Read the PDF
              </a>
            )}
            {d?.doi && (
              <a class="chip" href={`https://doi.org/${d.doi}`} rel="noopener">
                DOI
              </a>
            )}
          </p>
        )
      }
    </header>

    {
      paper.data.figure && (
        <Figure
          src={paper.data.figure.src}
          alt={paper.data.figure.alt}
          plate={paper.data.figure.plate}
          frame={paper.data.figure.frame}
        />
      )
    }

    <Prose>
      <Content />
    </Prose>

    {
      (projects.length > 0 || linkRows.length > 0) && (
        <section class="links" aria-labelledby="links-h">
          <h2 class="mono" id="links-h">
            Links
          </h2>
          {/* One column per group, plain links rather than chips: a chip reads
              as an action, and this section is an index of everywhere the work
              lives. The projects are a column like any other — they are one
              more place to go from here, and giving them their own row of chips
              made the section look like two sections. */}
          <div class="link-grid">
            {projects.length > 0 && (
              <div>
                <h3 class="mono">projects</h3>
                <ul>
                  {projects.map((p) => (
                    <li>
                      <a href={p.href} rel={p.external ? 'noopener' : undefined}>
                        {p.title}
                        {p.external && <span aria-hidden="true">↗</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {linkRows.map((row) => (
              <div>
                <h3 class="mono">{row.title}</h3>
                <ul>
                  {Object.entries(row.map!).map(([key, href]) => (
                    <li>
                      <a href={href} rel="noopener">
                        {label(key)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="cite" aria-labelledby="cite-h">
      <h2 class="mono" id="cite-h">Cite</h2>
      {
        /* BibTeX alone, deliberately.
         *
         * This section held a full <PubEntry> for a while, on the theory that
         * the badge, authors and citation count tell you whether this is the
         * thing you meant to cite. On a page that opens with exactly that
         * header it repeats all of it a screen further down, and it buries the
         * one thing the section is FOR behind a disclosure toggle. It also
         * needed a rule to hide the entry's own "Paper page" chip, which
         * pointed at the page you were already on — a component needing to be
         * partly hidden is the component being wrong for the place.
         *
         * Both sites this template came from tried it and moved back. */
      }
      {
        cite ? (
          <div class="cite-body">
            <CopyButton target={cite.id} />
            <pre id={cite.id}>{cite.bibtex}</pre>
          </div>
        ) : (
          /*
           * The section STAYS, with a sentence in place of the record.
           *
           * Hiding it would be the tidier markup and the worse page: a reader
           * who has just read a talk and wants to cite it would find the
           * heading missing and conclude that this site does not offer
           * citations, or that something failed to load. The absence is a fact
           * about the venue, not about the page, and the only way to say that
           * is to say it. No CopyButton: there is nothing to copy, and a button
           * that copies an empty string is worse than no button.
           */
          <p class="uncited">
            This was a talk at a venue that publishes no proceedings, so there is no bibliographic
            record of it and nothing to cite — that is a fact about the venue rather than a gap in
            this page.
            {linkRows.length > 0 && ' What it did leave behind is under Links, above.'}
          </p>
        )
      }
    </section>
  </article>
</Base>

<style>
  /* Header, figure, prose, links and the cite block all size to --measure, so
     their left and right edges line up the whole way down the page instead of
     each block picking its own width. */
  .kicker a {
    color: inherit;
  }
  .kicker a:hover {
    color: var(--sec-strong);
  }

  .head,
  .links,
  .cite {
    max-width: var(--measure);
  }

  .head {
    margin-bottom: 1.75rem;
  }

  /* Its own clamp rather than the global --fs-h1: a paper title is a sentence,
     not a page name, and at display size it becomes a wall four lines deep. */
  h1 {
    font-size: clamp(1.6rem, 1.1rem + 2.2vw, 2.5rem);
    margin-bottom: 0.75rem;
  }

  /* 1.8 because the ORCID badges sit above the baseline: at the default
     line-height they touch the names on the line above. */
  .byline {
    margin: 0 0 0.65rem;
    color: var(--text-muted);
    line-height: 1.8;
  }

  .venue-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .year {
    color: var(--text-faint);
  }

  /* The imprint: proceedings and place, the part a reader copies into a
     footnote rather than clicks. Italic, and below the badge row, because it
     is bibliography, not navigation. */
  .imprint,
  .also {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .imprint {
    font-style: italic;
  }
  .also {
    color: var(--text-faint);
  }
  /* The site's own author reads at full strength; the co-authors are context.
     Which one is "own" comes from SELF.surnames in src/consts.ts, so a group
     site that deletes SELF loses the emphasis and nothing else. */
  .author.self {
    color: var(--text);
    font-weight: 600;
  }
  /* The ORCID badge: the registry's own "iD" mark, small enough to read as a
     superscript on the name rather than as a second word in the author list.
     3px rather than --radius-s, because at this size the token's 8px is a pill. */
  .orcid {
    display: inline-block;
    margin-left: 0.35ch;
    padding: 0 0.3em;
    border: 1px solid var(--sec-line);
    border-radius: 3px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    vertical-align: 0.15em;
    color: var(--sec);
    text-decoration: none;
  }
  .orcid:hover {
    background: var(--sec-dim);
  }

  /* The one emphatic element on the page, because it is the one thing most
     readers arrived to do. Everything else here is a hairline. */
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.1rem 0 0;
  }
  .actions .primary {
    border-color: var(--sec-line);
    background: var(--sec-dim);
    color: var(--sec-strong);
  }

  .links {
    margin-top: 2.5rem;
  }
  /* auto-fit rather than a fixed column count: three or four groups sit side by
     side on a wide page and collapse to one column on a phone, no media query. */
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1.25rem;
  }
  .link-grid h3 {
    margin: 0 0 0.5rem;
    font-size: var(--fs-mono);
    color: var(--text-faint);
    text-transform: lowercase;
  }
  .link-grid ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.35rem;
  }
  .link-grid a {
    font-size: var(--fs-small);
  }

  .cite {
    margin-top: 2.5rem;
  }
  /* A statement, not a warning: the same muted grey as the imprint line, at the
     small size the rest of the header apparatus uses. Anything louder — a
     border, a colour — would read as an error on a page where nothing is
     wrong. */
  .uncited {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  /* Both section headings are labels, not titles: this page's one h1 is the
     paper, and a display-size "Links" would compete with it. */
  .links h2,
  .cite h2 {
    font-size: var(--fs-mono);
    font-weight: 500;
    color: var(--text-faint);
    margin-bottom: 0.5rem;
  }
  .bare {
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
