---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VenueBadge from '../../components/pub/VenueBadge.astro';
import { paperPath } from '../../lib/paths.ts';
import { paperPublication, paperVenue, paperVenueShort, paperYear } from '../../lib/papers.ts';

const papers = (await getCollection('papers')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

/*
 * Each row pulls its venue and year from the BibTeX entry the page points at,
 * the same as the detail page does — or, for a page with no entry, from what
 * that page states about itself. Both through the same helpers, so this list
 * and the page it links to cannot disagree about where something appeared.
 *
 * `tag` is the venue named in words, and it is here only for the rows that have
 * no badge: a page with no BibTeX entry has nothing in the badge column, and a
 * row showing a title and a year alone does not say where the work appeared.
 */
const rows = await Promise.all(
  papers.map(async (paper) => {
    const pub = await paperPublication(paper);
    const venue = paperVenue(paper);
    return {
      paper,
      pub,
      year: paperYear(paper, pub),
      tag: pub?.data.abbr
        ? undefined
        : [venue?.mark, paperVenueShort(paper, pub)].filter(Boolean).join(' '),
    };
  }),
);
---

<Base
  title="papers"
  description="Works with a page of their own: the abstract, the figure, and where to find them."
  section="papers"
>
  <section class="wrap section">
    <p class="kicker" data-sigil="##">papers</p>
    <h1>Papers</h1>
    <p class="lede">
      Not every publication needs a page. These are the ones with something more to say than the
      citation — an abstract, a figure, a replication package. The rest live on <a
        href="/publications/">publications</a
      >.
    </p>

    <ul class="list">
      {
        rows.map(({ paper, pub, year, tag }) => (
          <li class="item reveal">
            <div class="badge">
              <VenueBadge abbr={pub?.data.abbr} />
            </div>
            <div class="body">
              <h2>
                <a href={paperPath(paper.id)}>{paper.data.title}</a>
              </h2>
              {paper.data.description && <p class="desc">{paper.data.description}</p>}
              {year !== undefined && (
                <p class="mono meta">
                  {year}
                  {tag && <span> · {tag}</span>}
                  {/* The one thing about a paper that changes after it is
                      written, so it belongs in the list and not only on the
                      page: a reader scanning for what is new wants it here. */}
                  {paper.data.status === 'to-appear' && <span class="soon"> · to appear</span>}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .lede {
    max-width: 60ch;
    color: var(--text-muted);
  }

  .list {
    list-style: none;
    margin: 0;
  }
  .item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0 1.1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }
  .badge {
    padding-top: 0.3rem;
  }
  h2 {
    font-size: var(--fs-h3);
    margin: 0 0 0.35rem;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--sec-strong);
  }
  .desc {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    max-width: 62ch;
  }
  .meta {
    margin: 0;
    color: var(--text-faint);
  }
  .soon {
    color: var(--sec);
  }

  @media (max-width: 34rem) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
