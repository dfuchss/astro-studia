---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VenueBadge from '../../components/pub/VenueBadge.astro';
import { paperPath } from '../../lib/paths.ts';

const papers = (await getCollection('papers')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

// Each paper page pulls its venue and year from the BibTeX entry it points at,
// the same as the detail page does.
const rows = await Promise.all(
  papers.map(async (paper) => ({
    paper,
    pub: await getEntry(paper.data.publication),
  })),
);
---

<Base
  title="papers"
  description="Works with a page of their own: the abstract, the figure, and where to find them."
  section="papers"
>
  <section class="wrap section">
    <p class="kicker" data-sigil="##">papers</p>
    <h1>Papers</h1>
    <p class="lede">
      Not every publication needs a page. These are the ones with something more to say than the
      citation — an abstract, a figure, a replication package. The rest live on <a
        href="/publications/">publications</a
      >.
    </p>

    <ul class="list">
      {
        rows.map(({ paper, pub }) => (
          <li class="item reveal">
            <div class="badge">
              <VenueBadge abbr={pub?.data.abbr} />
            </div>
            <div class="body">
              <h2>
                <a href={paperPath(paper.id)}>{paper.data.title}</a>
              </h2>
              {paper.data.description && <p class="desc">{paper.data.description}</p>}
              {pub && <p class="mono meta">{pub.data.year}</p>}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .lede {
    max-width: 60ch;
    color: var(--text-muted);
  }

  .list {
    list-style: none;
    margin: 0;
  }
  .item {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0 1.1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }
  .badge {
    padding-top: 0.3rem;
  }
  h2 {
    font-size: var(--fs-h3);
    margin: 0 0 0.35rem;
  }
  h2 a {
    color: var(--text);
    text-decoration: none;
  }
  h2 a:hover {
    color: var(--sec-strong);
  }
  .desc {
    margin: 0 0 0.35rem;
    color: var(--text-muted);
    max-width: var(--measure);
  }
  .meta {
    margin: 0;
    color: var(--text-faint);
  }

  @media (max-width: 34rem) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }
  }
</style>
