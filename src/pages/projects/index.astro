---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/project/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

/**
 * The buckets, in the order they appear, with a line of context each.
 *
 * These stay on this page rather than in consts.ts: they have exactly one
 * consumer, and the ids are already constrained by the `category` enum in
 * content.config.ts, which is what actually stops a typo.
 */
const GROUPS: {
  id: (typeof projects)[number]['data']['category'];
  label: string;
  blurb: string;
}[] = [
  { id: 'research', label: 'Research', blurb: 'Long-running lines of work.' },
  { id: 'tools', label: 'Tools', blurb: 'Things built to be used by someone else.' },
  { id: 'misc', label: 'Elsewhere', blurb: 'Work that lives on another site.' },
];

const grouped = GROUPS.map((g) => ({
  ...g,
  items: projects.filter((p) => p.data.category === g.id),
})).filter((g) => g.items.length > 0);
---

<Base title="projects" description="Tools, corpora and long-running work." section="projects">
  <section class="wrap section">
    <p class="kicker" data-sigil="##">projects</p>
    <h1>Projects</h1>
    <p class="lede">
      {projects.length} entries. A card marked ↗ links straight out — that entry has a
      <code>redirect</code> in its front matter and no page here.
    </p>

    <nav class="jump mono" aria-label="Jump to a group">
      {
        grouped.map((g) => (
          <a class="chip" href={`#${g.id}`}>
            {g.label.toLowerCase()} <span>{g.items.length}</span>
          </a>
        ))
      }
    </nav>

    {
      grouped.map((g) => (
        <section class="group" id={g.id}>
          <h2>{g.label}</h2>
          <p class="blurb">{g.blurb}</p>
          <ul class="grid">
            {g.items.map((project) => (
              <ProjectCard project={project} />
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Base>

<style>
  .lede {
    max-width: 62ch;
    color: var(--text-muted);
  }
  .jump span {
    color: var(--sec);
  }

  .group {
    margin-top: 3rem;
  }
  .group h2 {
    margin-bottom: 0.25rem;
  }
  .blurb {
    max-width: 60ch;
    color: var(--text-faint);
    font-size: var(--fs-small);
    margin-bottom: 1.25rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.9rem;
    margin: 0;
    padding: 0;
  }
</style>
