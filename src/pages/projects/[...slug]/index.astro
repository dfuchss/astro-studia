---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import Prose from '../../../components/Prose.astro';
import Figure from '../../../components/Figure.astro';
import { PROJECTS } from '../../../lib/paths.ts';
/* ▼ FEATURE:papers ▼ */
import VenueBadge from '../../../components/pub/VenueBadge.astro';
import { paperPath } from '../../../lib/paths.ts';
import { paperPublication, paperVenueShort, paperYear } from '../../../lib/papers.ts';
/* ▲ FEATURE:papers ▲ */

export const getStaticPaths = (async () => {
  const projects = await getCollection('projects');
  return (
    projects
      // An entry with `redirect` lives somewhere else; generating a page here
      // would be a second, worse copy of it that search engines then have to
      // choose between.
      .filter((p) => !p.data.redirect)
      .map((project) => ({ params: { slug: project.id }, props: { project } }))
  );
}) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

/* ▼ FEATURE:papers ▼ */
/* The reverse index: every paper whose front matter names this project. By
   collection id, not title: a title match silently empties the list the first
   time somebody edits one. */
const papers = await getCollection('papers', (p) =>
  p.data.projects.some((ref) => ref.id === project.id),
);
const related = (
  await Promise.all(
    papers.map(async (paper) => {
      const pub = await paperPublication(paper);
      return {
        paper,
        pub,
        // Not `pub.data.year`: a page with no entry carries its own year, and
        // reading the entry alone would park it at the bottom of the list.
        year: paperYear(paper, pub),
        // Only used when there is no badge; see /papers/ for the same rule.
        tag: pub?.data.abbr ? undefined : paperVenueShort(paper, pub),
      };
    }),
  )
)
  // Newest edition first, then the order the paper list uses, so two works
  // from the same year keep the sequence a reader saw on /papers/.
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || a.paper.data.order - b.paper.data.order);
/* ▲ FEATURE:papers ▲ */
---

<Base title={d.title} description={d.description} section="projects">
  <article class="wrap section">
    <header class="head">
      {
        d.logo && (
          <Image class="logo" src={d.logo} alt="" width={64} height={64} densities={[1, 2]} />
        )
      }
      <div>
        <h1>{d.title}</h1>
        <p class="lede">{d.description}</p>
      </div>
    </header>

    {
      /* The overview diagram, when the front matter names one. Above the prose
         because it is the thing a reader wants first on an approach page: what
         is this, in one picture. Nothing renders when `figure` is unset. */
      d.figure && (
        <Figure
          src={d.figure.src}
          alt={d.figure.alt}
          plate={d.figure.plate}
          frame={d.figure.frame}
        />
      )
    }

    <Prose>
      <Content />
    </Prose>

    {
      /* This project's own repositories — not the site-wide /repositories/
         page, which is every repo the organisation has. */
      d.repositories.length > 0 && (
        <section class="block" aria-labelledby="code-h">
          <h2 class="mono" id="code-h">
            Code
          </h2>
          <ul class="chips">
            {d.repositories.map((r) => (
              <li>
                <a class="chip" href={r.url} rel="noopener">
                  {r.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {/* ▼ FEATURE:papers ▼ */}
    {
      related.length > 0 && (
        <section class="block" aria-labelledby="papers-h">
          <h2 class="mono" id="papers-h">
            {related.length === 1 ? 'Related paper' : 'Related papers'}
          </h2>
          <ul class="papers">
            {related.map(({ paper, pub, year, tag }) => (
              <li>
                <div class="badge">
                  <VenueBadge abbr={pub?.data.abbr} />
                </div>
                <div>
                  <a class="title" href={paperPath(paper.id)}>
                    {paper.data.title}
                  </a>
                  <p class="mono year">
                    {year}
                    {tag && <span> · {tag}</span>}
                    {paper.data.status === 'to-appear' && <span> · to appear</span>}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {/* ▲ FEATURE:papers ▲ */}

    <p class="back">
      <a class="chip" href={PROJECTS}>← All projects</a>
    </p>
  </article>
</Base>

<style>
  /* Header, prose and every block below them share one measure, so their left
     and right edges line up the whole way down the page. */
  .head,
  .block {
    max-width: var(--measure);
  }

  .head {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    margin-bottom: 2rem;
  }
  .logo {
    flex: none;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-m);
  }
  h1 {
    margin-bottom: 0.4rem;
  }
  .lede {
    margin: 0;
    color: var(--text-muted);
  }

  .block {
    margin-top: 2.5rem;
  }
  .block h2 {
    font-size: var(--fs-mono);
    font-weight: 500;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }

  .chips,
  .papers {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* The same two-column rail as the publication list: badge, then the entry.
     A reader who has seen /publications/ already knows how to read this. */
  .papers li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0 1.1rem;
    padding: 0.85rem 0;
    border-top: 1px solid var(--border);
  }
  .badge {
    padding-top: 0.15rem;
  }
  .title {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  .title:hover {
    color: var(--sec-strong);
  }
  .year {
    margin: 0.2rem 0 0;
    color: var(--text-faint);
  }

  .back {
    margin-top: 2.5rem;
  }

  @media (max-width: 34rem) {
    .papers li {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }
</style>
