---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts.ts';
import { repositories, languageColors, github } from '../lib/data.ts';
import { formatCount } from '../lib/citations.ts';

/*
 * Everything on this page comes from src/data/github-metadata.json, which is
 * committed. No API call happens during the build — see the header of
 * scripts/fetch-github-metadata.mjs.
 *
 * A repo listed in repositories.yml but missing from the metadata file just
 * does not render, rather than failing the build: the usual cause is adding a
 * line and not yet running `npm run data:github`, and a half-finished edit
 * should not stop you previewing the site.
 */
const repos = (repositories.github_repos ?? [])
  .map((name) => github.repos[name])
  .filter((r) => r !== undefined);

const users = (repositories.github_users ?? [])
  .map((login) => github.users[login])
  .filter((u) => u !== undefined);

const zenodo = repositories.zenodo_repos ?? [];

const missing = (repositories.github_repos ?? []).filter((n) => !github.repos[n]);

const fetched = new Intl.DateTimeFormat(SITE.locale, {
  dateStyle: 'medium',
  timeZone: 'UTC',
}).format(new Date(github.fetched));

const lang = (name: string | null) => (name ? (languageColors[name] ?? 'var(--text-faint)') : null);
---

<Base
  title="repositories"
  description="Code and datasets, from a metadata file committed to this repository."
  section="repositories"
>
  <section class="wrap section">
    <p class="kicker" data-sigil="##">repositories</p>
    <h1>Repositories</h1>
    <p class="lede">
      Rendered from <code>src/data/github-metadata.json</code>, refreshed by
      <code>npm run data:github</code>. The build itself makes no network calls.
    </p>
    <p class="mono asof">as of {fetched}</p>
  </section>

  {
    users.length > 0 && (
      <section class="wrap section block">
        <h2>Accounts</h2>
        <ul class="grid">
          {users.map((u) => (
            <li class="item reveal">
              <a class="row" href={u.htmlUrl} rel="noopener">
                <span class="name">{u.name ?? u.login}</span>
                <span class="mono handle">@{u.login}</span>
              </a>
              {u.bio && <p class="desc">{u.bio}</p>}
              <p class="mono stats">
                {formatCount(u.followers)} followers · {formatCount(u.publicRepos)} public repos
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    repos.length > 0 && (
      <section class="wrap section block">
        <h2>Code</h2>
        <ul class="grid">
          {repos.map((r) => (
            <li class="item reveal">
              <a class="row" href={r.htmlUrl} rel="noopener">
                <span class="name mono">{r.fullName}</span>
                {r.archived && <span class="chip archived">archived</span>}
              </a>
              {r.description && <p class="desc">{r.description}</p>}
              <p class="mono stats">
                {r.language && (
                  <span class="lang">
                    <span class="dot" style={`--lang: ${lang(r.language)}`} aria-hidden="true" />
                    {r.language}
                  </span>
                )}
                <span>★ {formatCount(r.stars)}</span>
                <span>⑂ {formatCount(r.forks)}</span>
                {r.license && <span>{r.license}</span>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    zenodo.length > 0 && (
      <section class="wrap section block">
        <h2>Archived</h2>
        <p class="blurb">
          Datasets and software releases with a DOI. No metadata to refresh — a DOI does not go
          stale.
        </p>
        <ul class="grid">
          {zenodo.map((z) => (
            <li class="item reveal">
              <a class="row" href={`https://doi.org/${z.doi}`} rel="noopener">
                <span class="name">{z.name}</span>
              </a>
              <p class="mono stats">{z.doi}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    missing.length > 0 && (
      <section class="wrap section block">
        <p class="missing">
          {missing.length} repositor{missing.length === 1 ? 'y is' : 'ies are'} listed in
          repositories.yml but absent from the metadata file. Run <code>npm run data:github</code>{' '}
          and commit the result.
        </p>
      </section>
    )
  }
</Base>

<style>
  .lede {
    max-width: 60ch;
    color: var(--text-muted);
  }
  .asof {
    margin: 0;
    color: var(--text-faint);
  }

  .block h2 {
    margin-bottom: 0.2rem;
  }
  .blurb {
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: 58ch;
    margin-bottom: 1rem;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 0.75rem 2rem;
  }

  /* Flat, like the rest of the site: a hairline rule instead of a filled tile. */
  .item {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    padding: 1rem 0.25rem 1rem;
    border-top: 1px solid var(--border);
    transition: border-color var(--dur) var(--ease);
  }
  .item:hover {
    border-top-color: var(--sec-line);
  }

  .row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    color: var(--text);
    text-decoration: none;
  }
  .row:hover .name {
    color: var(--sec-strong);
  }
  .name {
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .handle {
    color: var(--text-faint);
  }
  .archived {
    padding: 0.2em 0.5em;
    border-color: var(--warn);
    color: var(--warn);
  }

  .desc {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin: 0;
    color: var(--text-faint);
  }
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.4ch;
  }
  .dot {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: var(--lang);
  }

  .missing {
    color: var(--warn);
    font-size: var(--fs-small);
  }
</style>
