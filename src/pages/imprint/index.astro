---
import { FEATURES, disabled } from '../../features.ts';
import Base from '../../layouts/Base.astro';
import Email from '../../components/Email.astro';
import { SITE } from '../../consts.ts';
import { getPage } from '../../lib/pages.ts';

if (!FEATURES.imprint) return disabled();

/* The words: src/content/pages/imprint.md — the body is the box, `fields` the
   rows under it. */
const page = await getPage('imprint');
---

<Base {...page.meta()} section="home">
  <section class="wrap section page">
    <p class="kicker" data-sigil="##">
      imprint
    </p>
    <h1>Imprint</h1>

    <div class="notice">
      <page.Content />
    </div>

    <dl class="fields">
      {(page.data.fields ?? []).map((field) => (
        <div>
          <dt class="mono">{field.label}</dt>
          <dd>
            {field.lines.map((line, index) => (
              <>
                {index > 0 && <br />}
                {line}
              </>
            ))}
          </dd>
        </div>
      ))}
      <div>
        <dt class="mono">{page.label('contact')}</dt>
        <dd>
          <Email address={SITE.email} />
        </dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .page {
    max-width: var(--measure);
  }
  .notice {
    margin: 1.5rem 0 2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--warn);
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--warn) 10%, transparent);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .notice :global(p:last-child) {
    margin-bottom: 0;
  }
  .notice :global(strong) {
    color: var(--text);
  }

  .fields > div {
    padding: 0.8rem 0;
    border-top: 1px solid var(--border);
  }
  dt {
    color: var(--text-faint);
    font-size: var(--fs-mono);
    margin-bottom: 0.25rem;
  }
  dd {
    margin: 0;
  }
</style>
