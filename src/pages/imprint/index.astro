---
import Base from '../../layouts/Base.astro';
import Email from '../../components/Email.astro';
import { SITE } from '../../consts.ts';
---

<Base title="imprint" description="Site notice." section="home">
  <section class="wrap section page">
    <p class="kicker" data-sigil="##">imprint</p>
    <h1>Imprint</h1>

    <div class="notice">
      <p>
        <strong>This is a placeholder.</strong> It exists because several jurisdictions require a site
        notice with a real name and a real address — Germany's <em>Impressumspflicht</em> is the one most
        academics reading this will be subject to — and a template that quietly omitted the page would
        be a trap.
      </p>
      <p>
        Replace everything below with your own details, or delete
        <code>src/pages/imprint/index.astro</code> and its row in <code>FOOTER_LINKS</code> if you are
        not required to have one. Nothing here is legal advice.
      </p>
    </div>

    <dl class="fields">
      <div>
        <dt class="mono">Responsible for the content</dt>
        <dd>Your name</dd>
      </div>
      <div>
        <dt class="mono">Address</dt>
        <dd>Street and number<br />Postcode and town<br />Country</dd>
      </div>
      <div>
        <dt class="mono">Contact</dt>
        <dd><Email address={SITE.email} /></dd>
      </div>
    </dl>
  </section>
</Base>

<style>
  .page {
    max-width: var(--measure);
  }
  .notice {
    margin: 1.5rem 0 2rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--warn);
    border-radius: var(--radius-m);
    background: color-mix(in srgb, var(--warn) 10%, transparent);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .notice p:last-child {
    margin-bottom: 0;
  }
  .notice strong {
    color: var(--text);
  }

  .fields > div {
    padding: 0.8rem 0;
    border-top: 1px solid var(--border);
  }
  dt {
    color: var(--text-faint);
    font-size: var(--fs-mono);
    margin-bottom: 0.25rem;
  }
  dd {
    margin: 0;
  }
</style>
