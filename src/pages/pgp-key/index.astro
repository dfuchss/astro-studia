---
import { FEATURES, disabled } from '../../features.ts';
import Base from '../../layouts/Base.astro';
import CopyButton from '../../components/CopyButton.astro';
import { armoredKey, fingerprint, grouped, keyId, keyPath } from '../../lib/pgp.ts';
import { getPage, need } from '../../lib/pages.ts';

if (!FEATURES.pgp) return disabled();

// All of these derive from the single value in socials.yml, so they cannot
// disagree with one another. All are null when it is unset.
const keyFingerprint = fingerprint();
const id = keyId();
const pretty = grouped();
const asc = keyPath();

// Both null when public/assets/pgp-key/<FINGERPRINT>.asc is absent, leaving the
// fingerprint and key id: publishing only a fingerprint is a legitimate choice.
const key = armoredKey();

/* The site's words: src/content/pages/pgp-key.md. The advice and the setup
   notice below are the theme's. */
const page = await getPage('pgp-key');
const { label } = page;
---

<Base {...page.meta()} section="home">
  <section class="wrap section page">
    <p class="kicker" data-sigil="##">
      pgp
    </p>
    <h1>PGP key</h1>

    {keyFingerprint ? (
      <>
        <p class="lede">{need(page.data.lede, 'pgp-key.lede')}</p>
        <dl class="fields">
          <div>
            <dt class="mono">{label('fingerprint')}</dt>
            <dd class="mono fp">{pretty}</dd>
          </div>
          <div>
            <dt class="mono">{label('keyId')}</dt>
            <dd class="mono">{id}</dd>
          </div>
        </dl>
        {asc && (
          <p class="actions">
            <a class="chip" href={asc} download>
              {label('download')}
            </a>
          </p>
        )}

        {key && (
          <div class="keybox">
            <CopyButton target="pgp-key" label="Copy key" />
            <div class="scroll-x">
              <pre id="pgp-key">{key}</pre>
            </div>
          </div>
        )}

        <p class="hint">
          Verify the fingerprint over a second channel before you trust it. A key served from the
          same site as the address it belongs to proves very little on its own.
        </p>
      </>
    ) : (
      <div class="notice">
        <p>
          <strong>No key is configured.</strong> Set <code>pgp_fingerprint</code> in
          <code>src/data/socials.yml</code> to the 40-character fingerprint, then put the exported
          public key at <code>public/assets/pgp-key/&lt;FINGERPRINT&gt;.asc</code>.
        </p>
        <p>
          This page and the PGP chip in the profile row both appear on their own once it is set, and
          the key block is inlined here with a copy button as soon as the <code>.asc</code> file is
          in place. If you do not use PGP, set <code>pgp: false</code> in
          <code>src/features.ts</code>.
        </p>
      </div>
    )}
  </section>
</Base>

<style>
  .page {
    max-width: var(--measure);
  }
  .lede {
    color: var(--text-muted);
  }

  .fields > div {
    padding: 0.8rem 0;
    border-top: 1px solid var(--border);
  }
  dt {
    color: var(--text-faint);
    font-size: var(--fs-mono);
    margin-bottom: 0.25rem;
  }
  dd {
    margin: 0;
  }
  /* A fingerprint is read in groups of four and must not rewrap mid-group. */
  .fp {
    word-spacing: 0.35em;
    overflow-wrap: break-word;
  }

  .actions {
    margin: 1.25rem 0;
  }

  /* Positioned: CopyButton pins itself to the top right of its containing block. */
  .keybox {
    position: relative;
    margin: 1.5rem 0;
  }
  .keybox pre {
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--text-muted);
    margin: 0;
  }
  .hint {
    color: var(--text-faint);
    font-size: var(--fs-small);
  }

  .notice {
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
    background: var(--bg-1);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .notice p:last-child {
    margin-bottom: 0;
  }
  .notice strong {
    color: var(--text);
  }
</style>
