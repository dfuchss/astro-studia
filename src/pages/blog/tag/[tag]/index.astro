---
import { FEATURES } from '../../../../features.ts';
import type { GetStaticPaths } from 'astro';
import Base from '../../../../layouts/Base.astro';
import {
  publishedPosts,
  permalink,
  formatPostDate,
  groupByTag,
  slugifyTag,
} from '../../../../lib/blog.ts';
import { fill, getPage, need, pluralize } from '../../../../lib/pages.ts';

export const getStaticPaths = (async () => {
  /* getStaticPaths runs whatever the page's own guard says, and getCollection()
     on an emptied collection warns on every build. */
  if (!FEATURES.blog) return [];
  const posts = await publishedPosts();
  return groupByTag(posts).map(([tag, items]) => ({
    params: { tag: slugifyTag(tag) },
    // The display form is carried through as a prop: slugifyTag is lossy, so
    // "Formal Methods" could not be recovered from "formal-methods".
    props: { tag, items },
  }));
}) satisfies GetStaticPaths;

const { tag, items } = Astro.props;

/* The words: src/content/pages/blog.md. */
const page = await getPage('blog');
const title = fill(need(page.data.tagTitle, 'blog.tagTitle'), { tag });
const description = fill(need(page.data.tagDescription, 'blog.tagDescription'), { tag });
---

<Base section="blog" title={title} description={description}>
  <section class="wrap section">
    <p class="kicker" data-sigil="none">
      <a href="/blog/">blog</a> / tag
    </p>
    <h1>{tag}</h1>
    <p class="lede">{pluralize(need(page.data.tagCount, 'blog.tagCount'), items.length)}</p>

    <ol class="posts">
      {items.map((post) => (
        <li>
          <a href={permalink(post.id)}>
            <time class="mono" datetime={post.data.date.toISOString().slice(0, 10)}>
              {formatPostDate(post.data.date)}
            </time>
            <span>{post.data.title}</span>
          </a>
        </li>
      ))}
    </ol>
    <p class="back mono">
      <a href="/blog/">{page.label('back')}</a>
    </p>
  </section>
</Base>

<style>
  .kicker a {
    color: var(--text-faint);
  }
  .kicker a:hover {
    color: var(--sec);
  }
  .lede {
    color: var(--text-muted);
  }

  /* The same 11rem label column as /blog/ and the home page lists. */
  .posts {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }
  .posts a {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0 1.25rem;
    padding: 0.7rem 0.5rem;
    border-top: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-s);
  }
  .posts a:hover {
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
  .posts time {
    color: var(--text-faint);
  }

  .back {
    margin-top: 2rem;
  }
  .back a {
    color: var(--text-muted);
    text-decoration: none;
  }

  @media (max-width: 38rem) {
    .posts a {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>
