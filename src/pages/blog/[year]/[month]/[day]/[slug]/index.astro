---
import { FEATURES } from '../../../../../../features.ts';
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../../../../../layouts/Base.astro';
import Prose from '../../../../../../components/Prose.astro';
import {
  publishedPosts,
  permalink,
  permalinkParts,
  formatPostDate,
  slugifyTag,
} from '../../../../../../lib/blog.ts';
import { tagPath } from '../../../../../../lib/paths.ts';
import { getPage } from '../../../../../../lib/pages.ts';

export const getStaticPaths = (async () => {
  /* getStaticPaths runs whatever the page's own guard says, and getCollection()
     on an emptied collection warns on every build. */
  if (!FEATURES.blog) return [];
  // publishedPosts() drops drafts, so a draft has no route at all.
  const all = await publishedPosts();
  return all.map((post, index) => ({
    params: permalinkParts(post.id),
    // Neighbours are resolved here, where the sorted list already exists.
    props: { post, newer: all[index - 1], older: all[index + 1] },
  }));
}) satisfies GetStaticPaths;

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const frontmatter = post.data;

/* The pager's words: src/content/pages/blog.md. */
const { label } = await getPage('blog');
---

<Base section="blog" title={frontmatter.title} description={frontmatter.description}>
  <article class="wrap section">
    <p class="kicker" data-sigil="none">
      <a href="/blog/">blog</a>
    </p>

    <header class="head">
      <h1>{frontmatter.title}</h1>
      <p class="meta mono">
        <time datetime={frontmatter.date.toISOString().slice(0, 10)}>
          {formatPostDate(frontmatter.date)}
        </time>
        {frontmatter.tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            {frontmatter.tags.map((tag) => (
              <a href={tagPath(slugifyTag(tag))}>{tag}</a>
            ))}
          </>
        )}
      </p>
      {frontmatter.description && <p class="desc">{frontmatter.description}</p>}
    </header>

    <Prose>
      <Content />
    </Prose>

    {(older || newer) && (
      <nav class="pager" aria-label="More posts">
        {/* An empty span holds the grid column when there is no older post,
              so a lone "newer" link stays on the right where it belongs. */}
        {older ? (
          <a class="prev" href={permalink(older.id)}>
            <span class="mono">{label('older')}</span>
            <span>{older.data.title}</span>
          </a>
        ) : (
          <span />
        )}
        {newer && (
          <a class="next" href={permalink(newer.id)}>
            <span class="mono">{label('newer')}</span>
            <span>{newer.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </article>
</Base>

<style>
  .kicker a {
    color: var(--text-faint);
  }
  .kicker a:hover {
    color: var(--sec);
  }

  .head {
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  h1 {
    max-width: 40ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6ch;
    align-items: center;
    color: var(--text-faint);
    margin-bottom: 0.6rem;
  }
  .desc {
    max-width: 62ch;
    color: var(--text-muted);
    margin: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .pager a {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    background: var(--bg-1);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    text-decoration: none;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .pager a:hover {
    border-color: var(--sec-line);
    color: var(--sec-strong);
  }
  .pager .next {
    text-align: right;
  }
  .pager .mono {
    color: var(--text-faint);
    font-size: 0.6875rem;
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      text-align: left;
    }
  }
</style>
