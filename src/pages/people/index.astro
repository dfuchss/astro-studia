---
import { FEATURES, disabled } from '../../features.ts';
import Base from '../../layouts/Base.astro';
import PersonCard from '../../components/people/PersonCard.astro';
import { members } from '../../lib/people.ts';
import { getPage } from '../../lib/pages.ts';

if (!FEATURES.people) return disabled();

const list = await members();

/* The words: src/content/pages/people.md. */
const page = await getPage('people');
---

<Base {...page.meta()} section="people">
  <section class="wrap section">
    <p class="kicker" data-sigil="##">
      people
    </p>
    <h1>People</h1>
    <div class="lede">
      <page.Content />
    </div>

    <ul class="grid">
      {list.map((member) => (
        <PersonCard member={member} />
      ))}
    </ul>
  </section>
</Base>

<style>
  .lede {
    max-width: 60ch;
    color: var(--text-muted);
  }

  .grid {
    list-style: none;
    margin: 0;
    display: grid;
    /* auto-fit with a minimum, so one person is not a lonely card in a
       four-column grid and twelve do not become a wall of tiny ones. */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0.75rem 2rem;
  }
</style>
