---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubEntry from '../../components/pub/PubEntry.astro';
import { byYear } from '../../lib/publications.ts';
import { scholarMetrics, formatCount, formatUpdated } from '../../lib/citations.ts';
import { peopleLinks } from '../../lib/people.ts';

const pubs = await getCollection('publications');
const groups = byYear(pubs);
const metrics = scholarMetrics();
// Built once for the whole page, then handed to every entry.
const links = await peopleLinks();
---

<Base
  title="publications"
  description="Everything in src/data/papers.bib, newest first, with the BibTeX for each."
  section="publications"
>
  <section class="wrap section">
    <p class="kicker" data-sigil="##">publications</p>
    <h1>Publications</h1>
    <p class="lede">
      {pubs.length} entries, parsed from <code>src/data/papers.bib</code> at build time. Each one carries
      its own BibTeX; entries with a <strong>Paper page</strong> link have a page of their own.
    </p>

    {
      metrics.total > 0 && (
        <ul class="metrics">
          <li class="metric">
            <span class="metric-value">{formatCount(metrics.total)}</span>
            <span class="metric-label mono">citations</span>
            <span class="metric-sub mono">as of {formatUpdated(metrics.lastUpdated)}</span>
          </li>
          <li class="metric">
            <span class="metric-value">{metrics.hIndex}</span>
            <span class="metric-label mono">h-index</span>
          </li>
          <li class="metric">
            <span class="metric-value">{metrics.i10}</span>
            <span class="metric-label mono">i10-index</span>
          </li>
        </ul>
      )
    }

    <div class="filter">
      <label class="sr-only" for="pubsearch">Filter publications</label>
      <input
        id="pubsearch"
        type="search"
        placeholder="Filter by title, author or venue…"
        autocomplete="off"
        hidden
      />
    </div>
    <p class="no-results" hidden>No publications match that filter.</p>

    {
      groups.map((g) => (
        <section class="year" data-year={g.year}>
          <h2>{g.year}</h2>
          <ul class="entries">
            {g.items.map((pub) => (
              <PubEntry pub={pub} links={links} />
            ))}
          </ul>
        </section>
      ))
    }
  </section>
</Base>

<script>
  /*
   * Client-side filter over the whole list. No index, no library: the loader
   * already built a lowercased `searchText` per entry, so this is a substring
   * test over a few dozen strings and runs in well under a frame.
   *
   * The input ships `hidden` and this script reveals it, so with JS off there
   * is no dead control — the full list is there either way.
   */
  const input = document.querySelector<HTMLInputElement>('#pubsearch');
  const empty = document.querySelector<HTMLElement>('.no-results');
  const rows = [...document.querySelectorAll<HTMLElement>('.entry')];
  const years = [...document.querySelectorAll<HTMLElement>('.year')];

  if (input && empty) {
    input.hidden = false;

    const apply = (raw: string) => {
      const q = raw.trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const hit = q === '' || (row.dataset.search ?? '').includes(q);
        row.hidden = !hit;
        if (hit) shown += 1;
      }
      // Hide a year heading once everything under it is filtered out,
      // otherwise the page is a column of empty years.
      for (const year of years) {
        year.hidden = !year.querySelector('.entry:not([hidden])');
      }
      empty.hidden = shown > 0;
    };

    input.addEventListener('input', () => apply(input.value));

    // A fragment that is not an entry's own id is treated as a starting
    // filter, so /publications/#rhetoric is a shareable pre-filtered view.
    // Checking getElementById first keeps deep links to a single entry —
    // /publications/#cicero_de_officiis_1913 — scrolling to it instead.
    const hash = decodeURIComponent(location.hash.replace(/^#/, ''));
    if (hash && !document.getElementById(hash)) {
      input.value = hash;
      apply(hash);
    }
  }
</script>

<style>
  .lede {
    max-width: 60ch;
    color: var(--text-muted);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }
  /* Flat, like the home page stats: a hairline rule instead of a card. */
  .metric {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--border);
    transition: border-color var(--dur) var(--ease);
  }
  .metric:hover {
    border-top-color: var(--sec-line);
  }
  .metric-value {
    font-family: var(--font-head);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--sec);
  }
  .metric-label {
    color: var(--text-faint);
  }
  .metric-sub {
    color: var(--text-faint);
    font-size: 0.75rem;
  }

  .filter {
    margin-top: 1.5rem;
  }
  #pubsearch {
    width: min(100%, 28rem);
    padding: 0.6rem 0.9rem;
    font: inherit;
    font-size: var(--fs-small);
    color: var(--text);
    background: var(--bg-1);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-m);
  }
  #pubsearch:focus-visible {
    border-color: var(--sec-line);
  }
  .no-results {
    margin: 1rem 0 0;
    color: var(--text-faint);
    font-size: var(--fs-small);
  }

  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Sticky under the nav, which is 3.75rem tall, so the year you are reading
     stays visible while you scroll its entries. */
  .year h2 {
    position: sticky;
    top: 3.75rem;
    z-index: 1;
    margin: 2rem 0 0.25rem;
    padding: 0.5rem 0 0.4rem;
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--sec);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
</style>
