---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
/* ▼ FEATURE:socials ▼ */
import SocialRow from '../../components/SocialRow.astro';
/* ▲ FEATURE:socials ▲ */
import { SELF } from '../../consts.ts';
import {
  cv,
  dateRange,
  formatDate,
  isCurrent,
  layoutOf,
  countLabel,
  splitMinor,
  groupCourses,
  parseDetail,
} from '../../lib/cv.ts';
import { portrait, PORTRAIT_SIZE } from '../../lib/portrait.ts';

/* Each section picks its shape from its data unless `layout:` says otherwise
   (see layoutOf()), so adding a section to cv.yml needs no code here. */
const shaped = cv.sections.map((section) => ({ ...section, layout: layoutOf(section) }));
---

<Base title="Curriculum vitae" description={cv.summary} section="cv">
  <section class="wrap section">
    <div class="profile">
      <div>
        <p class="kicker" data-sigil="##">cv</p>
        <h1>Curriculum vitae</h1>
        {cv.summary && <p class="summary">{cv.summary}</p>}
        {
          cv.interests && cv.interests.length > 0 && (
            <ul class="interests">
              {cv.interests.map((i) => (
                <li class="chip">{i}</li>
              ))}
            </ul>
          )
        }
        <p class="who mono">{SELF.first} {SELF.last}</p>
        {
          /* The same rows as the entry page's contact block, from
            src/data/contact.yml — so a handle added there shows up here too,
            which is exactly what it did not do when this was one hand-written
            <Email> line. */
        }
        <Contact layout="inline" />
        {/* ▼ FEATURE:socials ▼ */}
        <SocialRow />
        {/* ▲ FEATURE:socials ▲ */}
      </div>
      <Image class="portrait" src={portrait} alt="" width={PORTRAIT_SIZE} height={PORTRAIT_SIZE} />
    </div>

    {
      shaped.map((section) => {
        const { main, minor } = splitMinor(section.entries);
        const courses = section.layout === 'courses' ? groupCourses(section.entries) : undefined;
        const count = countLabel(section);
        return (
          <section class="block" id={section.id}>
            <h2>
              {section.heading}
              {count && <span class="count mono">{count}</span>}
            </h2>

            {section.layout === 'cards' && (
              <>
                <ul class="cards">
                  {main.map((entry) => (
                    <li>
                      <h3>
                        {entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}
                        {entry.start && (
                          <span class="since mono">since {formatDate(entry.start)}</span>
                        )}
                      </h3>
                      {entry.note && <p class="detail">{entry.note}</p>}
                      {entry.highlights && entry.highlights.length > 0 && (
                        <p class="hl">
                          {entry.highlights.map((h) => (
                            <span class="chip">{h}</span>
                          ))}
                        </p>
                      )}
                    </li>
                  ))}
                </ul>
                {minor.length > 0 && (
                  <details class="more">
                    <summary>{minor.length} more</summary>
                    <ul class="cards">
                      {minor.map((entry) => (
                        <li>
                          <h3>
                            {entry.url ? <a href={entry.url}>{entry.title}</a> : entry.title}
                            {entry.start && (
                              <span class="since mono">since {formatDate(entry.start)}</span>
                            )}
                          </h3>
                          {entry.note && <p class="detail">{entry.note}</p>}
                          {entry.highlights && entry.highlights.length > 0 && (
                            <p class="hl">
                              {entry.highlights.map((h) => (
                                <span class="chip">{h}</span>
                              ))}
                            </p>
                          )}
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </>
            )}

            {section.layout === 'courses' && courses && (
              <>
                <ul class="courses">
                  {courses.current.map((c) => (
                    <li class="course now">
                      <span class="sem mono">{c.semester}</span>
                      <span class="cname">
                        {c.url ? (
                          <a href={c.url} rel="noopener">
                            {c.title}
                          </a>
                        ) : (
                          c.title
                        )}
                      </span>
                      {c.type && <span class="ctype mono">{c.type}</span>}
                    </li>
                  ))}
                </ul>
                {courses.past.length > 0 && (
                  <details class="more">
                    <summary>
                      {courses.past.length} earlier{' '}
                      {courses.past.length === 1 ? 'course' : 'courses'}
                    </summary>
                    <ul class="courses">
                      {courses.past.map((c) => (
                        <li class="course">
                          <span class="sem mono">{c.semester}</span>
                          <span class="cname">
                            {c.url ? (
                              <a href={c.url} rel="noopener">
                                {c.title}
                              </a>
                            ) : (
                              c.title
                            )}
                          </span>
                          {c.type && <span class="ctype mono">{c.type}</span>}
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </>
            )}

            {(section.layout === 'timeline' || section.layout === 'rows') && (
              <>
                <ol class:list={['entries', section.layout]}>
                  {main.map((entry) => (
                    <li>
                      <span class="when mono">{dateRange(entry)}</span>
                      <div class="what">
                        <h3>
                          {entry.title}
                          {isCurrent(entry) && <span class="now mono">now</span>}
                        </h3>
                        {entry.org && (
                          <p class="where">
                            {entry.url ? (
                              <a href={entry.url} rel="noopener">
                                {entry.org}
                              </a>
                            ) : (
                              entry.org
                            )}
                            {entry.location && <span class="muted">, {entry.location}</span>}
                          </p>
                        )}
                        {entry.note && <p class="detail note">{entry.note}</p>}
                        {entry.details && entry.details.length > 0 && (
                          <ul class="details">
                            {entry.details.map((d) => (
                              <li>
                                {parseDetail(d).map((part) =>
                                  part.url ? (
                                    <a href={part.url} rel="noopener">
                                      {part.text}
                                    </a>
                                  ) : (
                                    part.text
                                  ),
                                )}
                              </li>
                            ))}
                          </ul>
                        )}
                      </div>
                    </li>
                  ))}
                </ol>
                {minor.length > 0 && (
                  <details class="more">
                    <summary>{minor.length} more</summary>
                    <ol class:list={['entries', section.layout, 'compact']}>
                      {minor.map((entry) => (
                        <li>
                          <span class="when mono">{dateRange(entry)}</span>
                          <div class="what">
                            <h3>
                              {entry.title}
                              {isCurrent(entry) && <span class="now mono">now</span>}
                            </h3>
                            {entry.org && (
                              <p class="where">
                                {entry.url ? (
                                  <a href={entry.url} rel="noopener">
                                    {entry.org}
                                  </a>
                                ) : (
                                  entry.org
                                )}
                                {entry.location && <span class="muted">, {entry.location}</span>}
                              </p>
                            )}
                            {entry.note && <p class="detail note">{entry.note}</p>}
                            {entry.details && entry.details.length > 0 && (
                              <ul class="details">
                                {entry.details.map((d) => (
                                  <li>
                                    {parseDetail(d).map((part) =>
                                      part.url ? (
                                        <a href={part.url} rel="noopener">
                                          {part.text}
                                        </a>
                                      ) : (
                                        part.text
                                      ),
                                    )}
                                  </li>
                                ))}
                              </ul>
                            )}
                          </div>
                        </li>
                      ))}
                    </ol>
                  </details>
                )}
              </>
            )}
          </section>
        );
      })
    }
  </section>
</Base>

<style>
  /* No box: the lede reads as prose, closed off by the same hairline the rest
     of the site uses to separate sections. */
  .profile {
    display: grid;
    /* Same as the home page hero: cap the text at its reading measure so the
       portrait sits beside it rather than across a void at the far edge. */
    grid-template-columns: minmax(0, 64ch) auto;
    justify-content: start;
    gap: 2.5rem;
    align-items: center;
    margin-bottom: 3rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }
  /* Matches the home page hero portrait exactly. */
  .profile :global(.portrait) {
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--sec-line);
    box-shadow: 0 0 0 6px var(--sec-dim);
  }
  /* No cap of its own. `.profile`'s text column is already capped (64ch), and
     a second, tighter cap inside it only pulls the summary's right edge in
     from the interests chips and the contact line it shares that column with.
     A `--measure` (46rem) cap would be inert here anyway — the column is
     narrower than the token. */
  .summary {
    color: var(--text-muted);
  }
  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    margin: 1rem 0;
    padding: 0;
  }
  .who {
    margin: 0 0 0.35rem;
    color: var(--text-faint);
  }

  .block {
    margin-top: 3rem;
  }
  .block h2 {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .count {
    font-size: var(--fs-mono);
    color: var(--text-faint);
    font-weight: 400;
  }

  .entries,
  .courses {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  /* Timeline: a date rail on the left, content on the right. One custom
     property positions both the dot and the line, so they cannot end up a
     couple of pixels apart. */
  .timeline > li {
    --rail: 10.25rem;
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 0 1.25rem;
    padding-bottom: 1.5rem;
    position: relative;
  }
  .timeline > li::before {
    content: '';
    position: absolute;
    left: var(--rail);
    top: 0.45rem;
    margin-left: -3.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sec);
    box-shadow: 0 0 0 4px var(--sec-dim);
  }
  .timeline > li:not(:last-child)::after {
    content: '';
    position: absolute;
    left: var(--rail);
    top: 1.15rem;
    bottom: 0;
    margin-left: -0.5px;
    width: 1px;
    background: var(--border);
  }
  .timeline.compact > li {
    padding-bottom: 1rem;
  }

  /* Rows: for a section whose entries have no dates, where a rail would be a
     line of dots against nothing. */
  .rows > li {
    display: grid;
    grid-template-columns: 10.5rem 1fr;
    gap: 0 1.25rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--border);
  }

  .when {
    color: var(--text-faint);
    padding-top: 0.15rem;
  }
  .what h3 {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0 0 0.15rem;
    font-size: 1.0625rem;
  }
  .now {
    padding: 0.1em 0.5em;
    border: 1px solid var(--sec-line);
    border-radius: 999px;
    background: var(--sec-dim);
    color: var(--sec);
    font-size: var(--fs-mono);
    font-weight: 400;
  }
  .where {
    margin: 0 0 0.3rem;
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .detail {
    margin: 0;
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 68ch;
  }
  .note {
    font-style: italic;
  }
  .details {
    margin: 0.4rem 0 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: 68ch;
  }
  .details li {
    margin-bottom: 0.2rem;
  }
  .details li::marker {
    color: var(--sec);
  }
  .muted {
    color: var(--text-faint);
  }

  /* The disclosure toggle for a collapsed tail (mechanism 1) and for the
     past-semester run in `courses` (mechanism 2). One style for both, since
     both are "here is more of the same, folded away". */
  .more {
    margin-top: 0.5rem;
  }
  .more summary {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
    color: var(--sec);
    cursor: pointer;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--sec-line);
    border-radius: 999px;
    background: var(--sec-dim);
  }
  .more summary:hover {
    background: color-mix(in srgb, var(--sec-dim) 160%, transparent);
  }

  /* Courses: a semester column, the course name, and its kind — a row shape
     of its own because none of `timeline`, `rows` or `cards` has a natural
     place for a term that is not a date. */
  .course {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    gap: 0 1rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    align-items: baseline;
  }
  .course .sem {
    color: var(--text-faint);
  }
  .course.now .sem {
    color: var(--sec);
  }
  .ctype {
    color: var(--text-faint);
    font-size: 0.6875rem;
  }

  /* Cards: the one place on this site that reaches for a grid of tiles
     instead of a hairline list — a project needs room for a name, a "since"
     date and a row of highlight chips together, which a rail-and-row shape
     has nowhere to put. Still no filled box: the border is the same hairline
     the rest of the page uses, just on top instead of on the side. */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.4rem 1.6rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .cards > li {
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
  }
  .cards h3 {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }
  .since {
    color: var(--text-faint);
    font-weight: 400;
    font-size: 0.6875rem;
  }
  .hl {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0.6rem 0 0;
  }

  @media (max-width: 44rem) {
    .profile {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    .profile :global(.portrait) {
      order: -1;
      width: 7rem;
      height: 7rem;
    }
    /* The rail has nowhere to live once the date is above the entry rather
       than beside it. */
    .timeline > li,
    .rows > li {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .timeline > li::before,
    .timeline > li::after {
      display: none;
    }
    .course {
      grid-template-columns: 5rem 1fr;
    }
    .ctype {
      grid-column: 2;
    }
  }

  /* The CV is the one page people print, and a collapsed disclosure prints
     as collapsed — so force every one open and hide the toggle that would
     otherwise sit uselessly on paper. */
  @media print {
    .more[open] summary,
    .more summary {
      display: none;
    }
    .more {
      display: block;
    }
    .more > *:not(summary) {
      display: block !important;
    }
  }
</style>
