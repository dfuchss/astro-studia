---
import Base from '../layouts/Base.astro';
import DemoNotice from '../components/DemoNotice.astro';
import { SITE, SELF } from '../consts.ts';
---

<Base section="home">
  <DemoNotice />

  <section class="section wrap hero">
    <p class="kicker">whoami</p>
    <h1>{SELF.first} {SELF.last}</h1>
    <p class="tagline">{SITE.tagline}</p>
  </section>
</Base>

<style>
  .hero {
    max-width: var(--measure);
    margin-inline: 0;
  }
  .tagline {
    font-size: var(--fs-h3);
    color: var(--text-muted);
    max-width: 42ch;
  }
</style>
