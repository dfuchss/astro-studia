---
import { getCollection } from 'astro:content';

import { FEATURES, HOME_SHAPE } from '../features.ts';
import Base from '../layouts/Base.astro';
import DemoNotice from '../components/DemoNotice.astro';
import DemoSwitch from '../components/DemoSwitch.astro';
import Contact from '../components/Contact.astro';
import PersonHero from '../components/hero/PersonHero.astro';
import ProjectHero from '../components/hero/ProjectHero.astro';
import PaperEntry from '../components/paper/PaperEntry.astro';
import ProjectCard from '../components/project/ProjectCard.astro';
import PersonCard from '../components/people/PersonCard.astro';

import { featuredPapers } from '../lib/papers.ts';
import { publishedPosts, permalink, formatPostDate } from '../lib/blog.ts';
import { members } from '../lib/people.ts';
import { BLOG, PEOPLE, PROJECTS, PUBLICATIONS } from '../lib/paths.ts';

/*
 * The entry page, in both shapes: one person, or one project and its people.
 * HOME_SHAPE picks which renders at `/`, and with `demo` on its second URL
 * renders the other. Both stay here whatever the flags say.
 */
type Shape = 'profile' | 'project';
interface Props {
  /** Which shape to render. Only the demo's second URL ever passes it. */
  shape?: Shape;
}
const shape: Shape = (FEATURES.demo && Astro.props.shape) || HOME_SHAPE;
const isProfile = shape === 'profile';
const isProject = shape === 'project';

/* ── data the sections below read ─────────────────────────────────── */

/* A switched-off collection loads empty, so each of these would come back []
   on its own; the flag is stated so the dependency is readable here. */
const pubs = FEATURES.publications ? await getCollection('publications') : [];
const latestYear = pubs.length > 0 ? Math.max(...pubs.map((p) => p.data.year)) : undefined;

/* From the `papers` collection, not `publications.filter(pageSlug)`: a page
   whose venue is stated rather than cited has no row there. */
const papers = FEATURES.papers ? await featuredPapers() : [];

const posts = FEATURES.blog ? (await publishedPosts()).slice(0, 3) : [];

const subProjects = FEATURES.projects
  ? (await getCollection('projects')).sort(
      (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
    )
  : [];

const team = FEATURES.people ? await members() : [];

/* ── page text with one consumer, which is why it lives here ────────────── */

/* DEMO COPY. */
const interests = [
  'Moral philosophy',
  'Rhetoric and the theory of persuasion',
  'Translation as a technical problem',
  'Constitutional theory',
];

/* DEMO COPY. */
const involvement = [
  {
    text: 'Advocate before the',
    link: { label: 'Roman courts', href: 'https://www.perseus.tufts.edu/' },
    tail: 'from 81 BC, including the defence of Sextus Roscius',
  },
  {
    text: 'Member of the',
    link: { label: 'Senate', href: 'https://www.perseus.tufts.edu/' },
    tail: 'and, in 63 BC, consul',
  },
  // External, not /people/#atticus: that anchor is gone whenever people is off.
  {
    text: 'Correspondent of',
    link: { label: 'Atticus', href: 'https://en.wikipedia.org/wiki/Titus_Pomponius_Atticus' },
  },
];

/* DEMO COPY. */
const subProjectsBlurb =
  'Turning Greek philosophy into Latin took more than a translator: a vocabulary that ' +
  'did not exist yet, source texts worth basing a version on, and a way to get the ' +
  'result down as fast as it was dictated.';
---

<Base section="home">
  <DemoNotice />

  {FEATURES.demo && <DemoSwitch current={shape} />}

  <!-- Each section carries its own data-section, so the accent changes down the page. -->

  {isProfile && (
    <>
      <PersonHero />

      {FEATURES.publications && (
        <section class="wrap section" id="research" data-section="publications">
          <p class="kicker" data-sigil="##">
            research
          </p>
          <h2>What I work on</h2>
          <ul class="interests">
            {interests.map((i) => (
              <li class="chip">{i}</li>
            ))}
          </ul>

          {papers.length > 0 && (
            <>
              <h3 class="sub">Paper pages</h3>
              <p class="blurb">
                Some works get a page of their own — the figure, the argument, where to find the
                text.
              </p>
              <ul class="bare">
                {papers.map(({ paper, pub }) => (
                  <PaperEntry paper={paper} pub={pub} />
                ))}
              </ul>
            </>
          )}

          <p class="more mono">
            <a href={PUBLICATIONS}>
              all {pubs.length} publications{latestYear ? `, up to ${latestYear}` : ''} →
            </a>
          </p>
        </section>
      )}

      {FEATURES.projects && (
        <section class="wrap section" id="building" data-section="projects">
          <p class="kicker" data-sigil="##">
            building
          </p>
          <h2>Also involved in</h2>
          <ul class="involve">
            {involvement.map((i) => (
              <li>
                {i.text}{' '}
                <a href={i.link.href} rel={i.link.href.startsWith('http') ? 'noopener' : undefined}>
                  {i.link.label}
                </a>
                {i.tail && <span class="muted"> {i.tail}</span>}
              </li>
            ))}
          </ul>
          <p class="more mono">
            <a href={PROJECTS}>my own projects →</a>
          </p>
        </section>
      )}

      {posts.length > 0 && (
        <section class="wrap section" id="writing" data-section="blog">
          <p class="kicker" data-sigil="##">
            writing
          </p>
          <h2>Recent posts</h2>
          <ul class="postlist">
            {posts.map((p) => (
              <li>
                <a href={permalink(p.id)}>
                  <time class="mono" datetime={p.data.date.toISOString().slice(0, 10)}>
                    {formatPostDate(p.data.date)}
                  </time>
                  <span>{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="more mono">
            <a href={BLOG}>all posts →</a>
          </p>
        </section>
      )}
    </>
  )}

  {isProject && (
    <>
      <ProjectHero />

      {FEATURES.projects && (
        <section class="wrap section" id="subprojects" data-section="projects">
          <p class="kicker" data-sigil="##">
            sub-projects
          </p>
          <h2>What the programme runs on</h2>
          <p class="blurb">{subProjectsBlurb}</p>

          <ul class="grid">
            {subProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </ul>

          <p class="more mono">
            <a href={PROJECTS}>all {subProjects.length} sub-projects →</a>
          </p>
        </section>
      )}

      {FEATURES.publications && (
        <section class="wrap section" id="treatises" data-section="publications">
          <p class="kicker" data-sigil="##">
            treatises
          </p>
          <h2>The works themselves</h2>
          {papers.length > 0 && (
            <>
              <p class="blurb">
                {papers.length} of the works carry a page of their own — the argument, not just the
                citation.
              </p>

              <ul class="bare">
                {papers.map(({ paper, pub }) => (
                  <PaperEntry paper={paper} pub={pub} />
                ))}
              </ul>
            </>
          )}

          <p class="more mono">
            <a href={PUBLICATIONS}>all {pubs.length} publications →</a>
          </p>
        </section>
      )}

      {FEATURES.people && (
        <section class="wrap section" id="circle" data-section="people">
          <p class="kicker" data-sigil="##">
            circle
          </p>
          <h2>Who it passed through</h2>
          <p class="blurb">
            Correspondent, secretary, editor: {team.length} people the work relied on, none of them
            the author.
          </p>

          <ul class="grid people">
            {team.map((member) => (
              <PersonCard member={member} />
            ))}
          </ul>

          <p class="more mono">
            <a href={PEOPLE}>all {team.length} people →</a>
          </p>
        </section>
      )}
    </>
  )}

  <section class="wrap section" id="contact" data-section="contact">
    <p class="kicker" data-sigil="##">
      contact
    </p>
    <h2>Get in touch</h2>
    <p class="blurb">Questions, corrections and arguments all welcome.</p>

    <Contact />
  </section>
</Base>

<style>
  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0 0 2.25rem;
    padding: 0;
  }

  .sub {
    margin: 2.5rem 0 0.5rem;
    font-size: 1rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: lowercase;
  }

  .bare {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blurb {
    max-width: 60ch;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .more {
    margin: 1.25rem 0 0;
  }
  .more a {
    text-decoration: none;
  }

  .involve {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    max-width: 68ch;
  }
  .involve li {
    margin-bottom: 0.5rem;
    color: var(--text-muted);
  }
  .involve li::marker {
    color: var(--sec);
  }
  .muted {
    color: var(--text-faint);
  }

  .grid {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 0.9rem;
  }
  /* PersonCard rows read better wide than square; /people/ uses the same minimum. */
  .grid.people {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: 0.75rem 2rem;
  }

  .postlist {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  /* The same object as the contact rows in Contact.astro: a label column on a
     hairline rule, sharing --label-col so the two cannot drift apart. */
  .postlist a {
    display: grid;
    grid-template-columns: var(--label-col) 1fr;
    gap: 0 1.25rem;
    padding: 0.6rem 0.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-s);
  }
  .postlist a:hover {
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
  .postlist time {
    color: var(--text-faint);
  }

  @media (max-width: 44rem) {
    .postlist a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
