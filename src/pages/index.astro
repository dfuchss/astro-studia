---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

import Base from '../layouts/Base.astro';
import DemoNotice from '../components/DemoNotice.astro';
import SocialRow from '../components/SocialRow.astro';
import Email from '../components/Email.astro';
import PubEntry from '../components/pub/PubEntry.astro';

import { SITE, SELF } from '../consts.ts';
import { byNewest } from '../lib/publications.ts';
import { peopleLinks } from '../lib/people.ts';
import { scholarMetrics, formatCount } from '../lib/citations.ts';
import { publishedPosts, permalink, formatPostDate } from '../lib/blog.ts';
import { currentPosition, dateRange } from '../lib/cv.ts';
import { keyId } from '../lib/pgp.ts';

import portrait from '../assets/portrait.svg';

const pubs = await getCollection('publications');
const projects = await getCollection('projects');
const posts = (await publishedPosts()).slice(0, 3);
const links = await peopleLinks();
const m = scholarMetrics();
const position = currentPosition();
const pgp = keyId();

// The publications that have a page of their own, newest first.
const featured = pubs
  .filter((p) => p.data.pageSlug)
  .sort(byNewest)
  .slice(0, 3);

const latestYear = pubs.length > 0 ? Math.max(...pubs.map((p) => p.data.year)) : undefined;

/*
 * Counted, never typed in.
 *
 * A hardcoded "35 publications" is wrong the day you add the thirty-sixth, and
 * nothing tells you. Every number on this page is derived from the collection
 * it describes, so the page cannot disagree with the rest of the site.
 *
 * A stat whose value is 0 is dropped rather than shown as a zero.
 */
const stats = [
  { value: pubs.length, label: 'publications', href: '/publications/' },
  { value: m.total, label: 'citations', href: '/publications/' },
  { value: m.hIndex, label: 'h-index', href: '/publications/' },
  { value: projects.length, label: 'projects', href: '/projects/' },
].filter((s) => s.value > 0);

/* ──────────────────────────────────────────────────────────────────────────
   DEMO COPY. Everything from here to the end of this block is page text, not
   configuration — it has exactly one consumer, so it lives on the page that
   renders it rather than in src/consts.ts. Rewrite it; do not look for a
   setting.
   ────────────────────────────────────────────────────────────────────────── */
const interests = [
  'Moral philosophy',
  'Rhetoric and the theory of persuasion',
  'Translation as a technical problem',
  'Constitutional theory',
];

const involvement = [
  {
    text: 'Advocate before the',
    link: { label: 'Roman courts', href: 'https://www.perseus.tufts.edu/' },
    tail: 'from 81 BC, including the defence of Sextus Roscius',
  },
  {
    text: 'Member of the',
    link: { label: 'Senate', href: 'https://www.perseus.tufts.edu/' },
    tail: 'and, in 63 BC, consul',
  },
  { text: 'Correspondent of', link: { label: 'Atticus', href: '/people/#atticus' } },
];
/* ──────────────────────────── end of demo copy ─────────────────────────── */
---

<Base section="home">
  <DemoNotice />

  <!-- hero -->
  <section class="wrap hero">
    <div class="hero-grid">
      <div>
        <p class="kicker">whoami</p>
        <h1>{SELF.first}&nbsp;{SELF.last}</h1>
        <p class="role">{SITE.tagline}</p>
        <p class="pitch">
          I write about <strong>duty</strong>, <strong>friendship</strong> and what holds a republic together,
          and I argue that Latin is perfectly capable of the job — which is a claim you can only make
          by doing it.
        </p>
        <SocialRow />
      </div>

      <figure class="portrait">
        <Image src={portrait} alt="" width={320} height={320} loading="eager" />
      </figure>
    </div>

    {
      stats.length > 0 && (
        <ul class="stats">
          {stats.map((s) => (
            <li>
              <a href={s.href}>
                <span class="stat-value">{formatCount(s.value)}</span>
                <span class="stat-label mono">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <!-- Each section carries its own data-section, so the accent changes as you
       move down the page — the same mechanism the nav uses. -->
  <section class="wrap section" id="research" data-section="publications">
    <p class="kicker" data-sigil="##">research</p>
    <h2>What I work on</h2>
    <ul class="interests">
      {interests.map((i) => <li class="chip">{i}</li>)}
    </ul>

    {
      featured.length > 0 && (
        <>
          <h3 class="sub">Paper pages</h3>
          <p class="blurb">
            Some works get a page of their own — the figure, the argument, where to find the text.
          </p>
          <ul class="bare">
            {featured.map((pub) => (
              <PubEntry pub={pub} links={links} compact />
            ))}
          </ul>
        </>
      )
    }

    <p class="more mono">
      <a href="/publications/">
        all {pubs.length} publications{latestYear ? `, up to ${latestYear}` : ''} →
      </a>
    </p>
  </section>

  <section class="wrap section" id="building" data-section="projects">
    <p class="kicker" data-sigil="##">building</p>
    <h2>Also involved in</h2>
    <ul class="involve">
      {
        involvement.map((i) => (
          <li>
            {i.text}{' '}
            <a href={i.link.href} rel={i.link.href.startsWith('http') ? 'noopener' : undefined}>
              {i.link.label}
            </a>
            {i.tail && <span class="muted"> {i.tail}</span>}
          </li>
        ))
      }
    </ul>
    <p class="more mono"><a href="/projects/">my own projects →</a></p>
  </section>

  {
    posts.length > 0 && (
      <section class="wrap section" id="writing" data-section="blog">
        <p class="kicker" data-sigil="##">
          writing
        </p>
        <h2>Recent posts</h2>
        <ul class="postlist">
          {posts.map((p) => (
            <li>
              <a href={permalink(p.id)}>
                <time class="mono" datetime={p.data.date.toISOString().slice(0, 10)}>
                  {formatPostDate(p.data.date)}
                </time>
                <span>{p.data.title}</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="more mono">
          <a href="/blog/">all posts →</a>
        </p>
      </section>
    )
  }

  <section class="wrap section" id="contact" data-section="cv">
    <p class="kicker" data-sigil="##">contact</p>
    <h2>Get in touch</h2>
    <p class="blurb">Happy to argue about any of the above.</p>

    <dl class="contact">
      <div class="line">
        <dt class="mono">email</dt>
        <dd><Email address={SITE.email} /></dd>
      </div>
      {
        pgp && (
          <div class="line">
            <dt class="mono">pgp</dt>
            <dd>
              <a href="/pgp-key/">{pgp}</a>
              <span class="muted"> — for anything sensitive</span>
            </dd>
          </div>
        )
      }
      {
        position && (
          /* Read from cv.yml rather than written twice, so this line cannot
             disagree with /cv/. */
          <div class="line">
            <dt class="mono">where</dt>
            <dd>
              {position.url ? (
                <a href={position.url} rel="noopener">
                  {position.org ?? position.title}
                </a>
              ) : (
                (position.org ?? position.title)
              )}
              <span class="muted"> — {dateRange(position)}</span>
            </dd>
          </div>
        )
      }
    </dl>
    <p class="more mono"><a href="/cv/">full cv →</a></p>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 7vw, 5rem) 0;
  }
  .hero-grid {
    display: grid;
    /* Cap the text column at its reading measure. With `1fr` the column eats
       all the free width and pushes the portrait to the far edge, leaving a
       void between the two. `start` keeps the pair together, left-aligned like
       every other section on the page. */
    grid-template-columns: minmax(0, 64ch) auto;
    justify-content: start;
    gap: 2.5rem;
    align-items: center;
  }

  h1 {
    margin-bottom: 0.35rem;
  }
  .role {
    font-size: 1.0625rem;
    color: var(--text-muted);
    margin-bottom: 0.9rem;
  }
  .pitch {
    max-width: 56ch;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .pitch strong {
    color: var(--text);
    font-weight: 600;
  }

  .portrait {
    margin: 0;
    text-align: center;
  }
  .portrait :global(img) {
    width: 11rem;
    height: 11rem;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--sec-line);
    box-shadow: 0 0 0 6px var(--sec-dim);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  /* No box: a hairline rule over each figure, matching the dividers the rest
     of the site uses. The number carries the emphasis, not a border. */
  .stats a {
    display: grid;
    gap: 0.1rem;
    padding: 0.85rem 0 0;
    border-top: 1px solid var(--border);
    text-decoration: none;
    transition: border-color var(--dur) var(--ease);
  }
  .stats a:hover {
    border-top-color: var(--sec-line);
  }
  .stats a:hover .stat-label {
    color: var(--sec);
  }
  .stat-value {
    font-family: var(--font-head);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--sec);
  }
  .stat-label {
    color: var(--text-faint);
    font-size: 0.6875rem;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    margin: 0 0 2.25rem;
    padding: 0;
  }

  .sub {
    margin: 2.5rem 0 0.5rem;
    font-size: 1rem;
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-weight: 500;
    text-transform: lowercase;
  }

  .bare {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .blurb {
    max-width: 58ch;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .more {
    margin: 1.25rem 0 0;
  }
  .more a {
    text-decoration: none;
  }

  .involve {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
    max-width: 68ch;
  }
  .involve li {
    margin-bottom: 0.5rem;
    color: var(--text-muted);
  }
  .involve li::marker {
    color: var(--sec);
  }
  .muted {
    color: var(--text-faint);
  }

  .postlist {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  /* The post list and the contact rows are the same object: a label column on
     a hairline rule. One declaration, so they cannot drift out of alignment. */
  .postlist a,
  .contact .line {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0 1.25rem;
    padding: 0.6rem 0.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--fs-small);
  }
  .postlist a {
    text-decoration: none;
    color: inherit;
    border-radius: var(--radius-s);
  }
  .postlist a:hover {
    background: var(--sec-dim);
    color: var(--sec-strong);
  }
  .postlist time {
    color: var(--text-faint);
  }

  .contact {
    margin: 1.25rem 0 0;
    max-width: 46rem;
  }
  .contact .line {
    align-items: baseline;
    transition: border-color var(--dur) var(--ease);
  }
  .contact .line:hover {
    border-top-color: var(--sec-line);
  }
  .contact dt {
    color: var(--text-faint);
  }
  .contact dd {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
    /* Addresses and fingerprints have no spaces to break at. */
    overflow-wrap: anywhere;
  }

  @media (max-width: 44rem) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    /* Portrait above the text on a phone: an 11rem image beside a paragraph at
       that width leaves the paragraph a few characters wide. It also shrinks —
       full desktop size on a phone eats the fold. cv.astro does the same. */
    .portrait {
      order: -1;
      text-align: left;
    }
    .portrait :global(img) {
      width: 7rem;
      height: 7rem;
    }
    .postlist a,
    .contact .line {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
